<?xml version="1.0" encoding="utf-8"?>
<!-- The incoming page is revealed UNDERNEATH the one peeling off the spine (DESIGN.md §5): it settles
     in place with a gentle fade + slight scale-up, rather than sliding in like a wipe. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_quad">
    <alpha android:fromAlpha="0.3" android:toAlpha="1.0" android:duration="240" />
    <scale android:fromXScale="0.98" android:toXScale="1.0" android:fromYScale="0.98" android:toYScale="1.0"
        android:pivotX="0%" android:pivotY="50%" android:duration="240" />
</set>
