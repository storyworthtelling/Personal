<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The Paper & Ink activity theme: warm paper window, ink text, terracotta
         accent (dialog buttons, cursors, selection handles). Light-only by design. -->
    <style name="Theme.FocusPhone.Paper" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/paper_background</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/paper</item>
        <item name="android:colorEdgeEffect">@color/hairline</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/inkMuted</item>
        <item name="android:textColorHint">@color/inkMuted</item>
    </style>
</resources>
