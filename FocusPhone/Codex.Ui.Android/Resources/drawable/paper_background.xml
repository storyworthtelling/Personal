<?xml version="1.0" encoding="utf-8"?>
<!-- The paper window: flat paper under the tiled grain (DESIGN.md §6).
     paper_grain.png is generated by Tools/IconStudio (drawable-nodpi so the
     noise stays pixel-true at every density). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/paper" />
    <item>
        <bitmap android:src="@drawable/paper_grain" android:tileMode="repeat" />
    </item>
</layer-list>
