<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>FocusPhone.Audio</RootNamespace>
    <ApplicationId>com.storyworthtelling.focusphone.audio</ApplicationId>
    <ApplicationTitle>Audio</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>34</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FocusPhone.Domain\FocusPhone.Domain.csproj" />
    <ProjectReference Include="..\FocusPhone.Infrastructure\FocusPhone.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer" Version="1.8.0.2" />
    <PackageReference Include="Xamarin.AndroidX.Media3.Session" Version="1.8.0.2" />
  </ItemGroup>
</Project>
