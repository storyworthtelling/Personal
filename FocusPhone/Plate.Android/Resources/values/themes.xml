<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat variant of the Paper & Ink theme for the Camera head (its
         activity is an AppCompatActivity). Colors come from the shared
         Codex.Ui.Android resource merge. -->
    <style name="Theme.FocusPhone.Paper.AppCompat" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/inkMuted</item>
    </style>
</resources>
