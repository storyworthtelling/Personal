<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Score</RootNamespace>
    <ApplicationId>com.storyworthtelling.focusphone.audio</ApplicationId>
    <ApplicationTitle>Score</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>34</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- TidalKotlinBridge builds raw JNI argument arrays with stackalloc, the same as
         the generated Codex.Tidal.Binding constructors it mirrors. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Codex.Domain\Codex.Domain.csproj" />
    <ProjectReference Include="..\Codex.Infrastructure\Codex.Infrastructure.csproj" />
    <ProjectReference Include="..\Codex.Ui.Android\Codex.Ui.Android.csproj" />
    <ProjectReference Include="..\Codex.Tidal.Binding\Codex.Tidal.Binding.csproj" />
    <!-- The update channel's shared decisions: which APKs this app installs, and what
         its role is on the phone it woke up on. -->
    <ProjectReference Include="..\..\Storyworthtelling.Updates\Storyworthtelling.Updates.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer" Version="1.8.0.2" />
    <PackageReference Include="Xamarin.AndroidX.Media3.Session" Version="1.8.0.2" />
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.74.0.*" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="2.10.2" />
    <!-- The player's component is generated by Dagger (DaggerPlayerComponent), and an .aar
         carries only the generated code, not the runtime it calls into. Without this the
         Player constructor threw NoClassDefFoundError on dagger.internal.Preconditions and
         Score skipped the TIDAL session entirely. Kept out of Codex.Tidal.Binding, where it
         broke the binding's own generated code. -->
    <PackageReference Include="Xamarin.Google.Dagger" Version="2.57.2.1" />
  </ItemGroup>
</Project>
