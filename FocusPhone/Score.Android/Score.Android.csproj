<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Score</RootNamespace>
    <ApplicationId>com.storyworthtelling.focusphone.audio</ApplicationId>
    <ApplicationTitle>Score</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>34</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Codex.Domain\Codex.Domain.csproj" />
    <ProjectReference Include="..\Codex.Infrastructure\Codex.Infrastructure.csproj" />
    <ProjectReference Include="..\Codex.Ui.Android\Codex.Ui.Android.csproj" />
    <ProjectReference Include="..\Codex.Tidal.Binding\Codex.Tidal.Binding.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer" Version="1.8.0.2" />
    <PackageReference Include="Xamarin.AndroidX.Media3.Session" Version="1.8.0.2" />
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.74.0.*" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="2.10.2" />
  </ItemGroup>
</Project>
