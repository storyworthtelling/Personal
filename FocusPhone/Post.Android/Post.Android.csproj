<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Post</RootNamespace>
    <ApplicationId>com.storyworthtelling.focusphone.communication</ApplicationId>
    <ApplicationTitle>Post</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>34</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Codex.Domain\Codex.Domain.csproj" />
    <ProjectReference Include="..\Codex.Infrastructure\Codex.Infrastructure.csproj" />
    <ProjectReference Include="..\Codex.Ui.Android\Codex.Ui.Android.csproj" />
    <ProjectReference Include="..\..\Storyworthtelling.Updates\Storyworthtelling.Updates.csproj" />
    <!-- Dash on the watch (P14 W-4.1.1, B2): the Dash contracts' codec and paths, the same ones the watch reads. BCL only. -->
    <ProjectReference Include="..\..\Watch\Watch.Domain\Watch.Domain.csproj" />
  </ItemGroup>

  <!-- In-app texting: reference the gmbridge binding only when its .aar has been
       built (CI builds it before the heads). When absent, GMBRIDGE is undefined
       and GmBridgeClient compiles to a stub, so the head still builds and texting
       falls back to the Google Messages deep link. -->
  <PropertyGroup Condition="Exists('..\gmbridge\gmbridge.aar')">
    <DefineConstants>$(DefineConstants);GMBRIDGE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('..\gmbridge\gmbridge.aar')">
    <ProjectReference Include="..\Codex.GmBridge.Binding\Codex.GmBridge.Binding.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.Work.Runtime" />
    <!-- WorkManager needs androidx.concurrent.futures; without a direct reference, transitive pinning drops it from
         the APK and the app dies at start (OneBuildSettingTests.EveryProjectWithWorkManagerNamesConcurrentFuturesItself). -->
    <PackageReference Include="Xamarin.AndroidX.Concurrent.Futures" />
    <!-- The Data Layer (MessageClient, the listener service), Microsoft's binding of play-services-wearable: CLAUDE.md's
         dependency rule 2, and the only way Dash on the watch reaches Post (P14 B2), as Flyleaf reaches the installer. -->
    <PackageReference Include="Xamarin.GooglePlayServices.Wearable" />
    <!-- As Flyleaf's: Play services' Fragment 1.9 needs LiveData.Core 2.11, which WorkManager 2.10's LiveData 2.9.1 refuses
         by an exact range (NU1107), so the head takes LiveData 2.11 itself. No central version: with transitive pinning one
         would be forced on every head (OneBuildSettingTests.LiveDataIsNotPinnedForEveryone). -->
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" VersionOverride="2.11.0.1" />
  </ItemGroup>

  <!-- Preserve SQLitePCLRaw from the Release IL trimmer. Its provider is wired
       up by a module initializer and reflection; trimming it makes the first
       SqliteConnection.Open() fail at runtime (the app crashed on launch). -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Microsoft.Data.Sqlite" RootMode="All" />
    <TrimmerRootAssembly Include="SQLitePCLRaw.core" RootMode="All" />
    <TrimmerRootAssembly Include="SQLitePCLRaw.batteries_v2" RootMode="All" />
    <TrimmerRootAssembly Include="SQLitePCLRaw.provider.e_sqlite3" RootMode="All" />
  </ItemGroup>
</Project>
