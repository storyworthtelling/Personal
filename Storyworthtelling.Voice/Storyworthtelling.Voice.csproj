<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The shared "owner's voice" library, referenced by every com.storyworthtelling app (Storyboarder,
    Ledger, FocusPhone, …). It learns a voice profile from documents the owner uploads and composes
    situational UI messages in that voice. Pure .NET (HttpClient + System.Text.Json + Google Drive), no
    MAUI/Android APIs, so any Android head can reference it directly and the desktop test builds compile it
    without the Android workload. Multi-targeted net9.0;net10.0 because the heads are on different runtimes
    (DailyLoader is net9.0-android; the rest net10.0-android) — each consumer picks the matching asset. The
    Extensions packages are pinned to 9.0.0 so the one version works for both TFMs (only the stable
    IOptions/ILogger surface is used); Google.Apis is netstandard2.0 and version-agnostic here.
  -->
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Storyworthtelling.Voice</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The profile is stored as a JSON file in the owner's Google Drive so every app shares one voice. -->
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.74.0.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.0" />
  </ItemGroup>

</Project>
