<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <RootNamespace>Foreword.Android</RootNamespace>
    <ApplicationId>com.storyworthtelling.dailyloader</ApplicationId>
    <!-- The name on the phone. The ApplicationId above deliberately does not follow it: a device
         recognises an update only when the package name is unchanged. -->
    <ApplicationTitle>Foreword</ApplicationTitle>
    <!-- versionCode comes from the shared .github/actions/version-code action (band 7), like
         every other app in the suite: band * 100,000,000 + minutes since 2020-01-01 UTC. This
         value is only the fallback for a local build; CI always overrides it with -p. It used
         to be a yearDigit + MMddHHmm timestamp computed here, which was correct but was the one
         app doing its own thing — and a second implementation of the same rule is how the two
         run_number floors drifted. Storyworthtelling.Updates.SuiteVersionBands records the band
         and guards that it clears what this package has already shipped. -->
    <ApplicationVersion>1</ApplicationVersion>
    <!-- The version the OWNER reads, printed by the Settings foot line. P9 is the 2.0 line, and
         the mockups draw it as "Foreword 2.0.512 · com.storyworthtelling.dailyloader". CI replaces
         the last part with the workflow's run number; this value is only what a local build shows.
         It used to be a UTC build stamp, which was monotonic and correct and unreadable — nobody
         says "I'm on 2026.09.06.1432" out loud, and the foot line exists to be read back. -->
    <ApplicationDisplayVersion>2.0.0</ApplicationDisplayVersion>
    <AndroidMinSdkVersion>26</AndroidMinSdkVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- App icon = native Android adaptive-icon resources under Resources/ (mipmap-*), generated by
       Tools/IconStudio. MAUI's MauiIcon/resizetizer pipeline is bypassed. The resources live in the
       plain Resources/ folder (NOT Platforms/Android/Resources) on purpose: this head does not set
       <SingleProject>true</SingleProject>, so MAUI leaves the .NET-for-Android default resource prefix
       (`Resources`) in place — anything under Platforms/Android/Resources is never packaged. android:icon
       is set via [Application(Icon=...)] in MainApplication.cs, not the (unwired) XML manifest. The CI
       ICON CHECK fails the build if the launcher icon is missing from the APK. -->

  <ItemGroup>
    <ProjectReference Include="..\Foreword.Infrastructure\Foreword.Infrastructure.csproj" />
    <!-- Shared owner's-voice library: greet the owner in their voice on the delivery screen, reading the
         shared profile + Claude key from Drive (brings Google.Apis.Drive.v3/Auth transitively). -->
    <ProjectReference Include="..\..\Storyworthtelling.Voice\Storyworthtelling.Voice.csproj" />
    <ProjectReference Include="..\..\Storyworthtelling.Remarkable\Storyworthtelling.Remarkable.csproj" />
    <ProjectReference Include="..\..\Storyworthtelling.Updates\Storyworthtelling.Updates.csproj" />
    <!-- Shared hand-written-note extraction library (Index-P11 Release F): MauiProgram wires
         Foreword's own instruction text and credential id into the shared extractor directly. -->
    <ProjectReference Include="..\..\Storyworthtelling.Handwriting\Storyworthtelling.Handwriting.csproj" />
    <!-- The shared Paper & Ink kit: the role table, the component styles, and the eight fonts with
         their aliases. It replaces this head's private DesignTokens.xaml and its own MauiFont glob —
         a head that packages the fonts itself can register an alias for a face the kit does not
         carry, which fails silently. -->
    <ProjectReference Include="..\..\Storyworthtelling.Maui\Storyworthtelling.Maui.csproj" />
    <!-- The printing library. Reached transitively through Infrastructure until Release I, when this
         head began naming its types directly — the maker's mark it hands over, and the squaring of
         the photo it is given. A direct dependency is declared rather than inherited: the transitive
         one is real but it is a property of somebody else's csproj, and this head is the one project
         in the repo that cannot be compiled outside CI. -->
    <ProjectReference Include="..\..\Storyworthtelling.Paper\Storyworthtelling.Paper.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
    <PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="2.10.2" />
    <!-- Pin to resolve a Work.Runtime 2.10.2 transitive conflict under .NET 10 MAUI: AndroidX.Core
         wants Concurrent.Futures >=1.3.0.1 while Concurrent.Futures.Ktx caps it <1.2.1 (NuGet NU1107).
         Matches the pin Storyboarder/Ledger already carry. -->
    <PackageReference Include="Xamarin.AndroidX.Concurrent.Futures" Version="1.3.0.1" />
  </ItemGroup>

  <!-- Preserve PDFsharp from the Release IL trimmer — uses reflection internally -->
  <ItemGroup>
    <TrimmerRootAssembly Include="PdfSharp" RootMode="All" />
  </ItemGroup>
</Project>
