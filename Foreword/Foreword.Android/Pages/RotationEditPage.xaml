<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Foreword.Android.Pages.RotationEditPage"
             Title="List">
    <!--
        NOT IN THE APPROVED MOCKUP SET — see RotationsPage.xaml. Built in TaskEditPage's grammar:
        labelled field rows in a hairline card, a segmented control rather than a switch (§8), a
        pinned bottom bar, a destructive action set apart in it, and no Save (D35) — every change
        commits as it is made.

        MOVE, NOT DRAG. Reordering is two buttons per row, because the target has to be big enough
        to hit with a thumb and a drag handle on a 48dp row is not (Plate's scan tray settled this
        for the same reason).

        Mockups: https://claude.ai/code/artifact/6bb65b0d-04da-47f3-bf72-a04020217e0c
    -->
    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="{StaticResource ScreenPadding}" Spacing="0">

                <Label x:Name="Heading" Text="List" Style="{StaticResource DisplayLabel}" />

                <Label x:Name="StatusLabel" Style="{StaticResource StatusLine}" IsVisible="False" />

                <Border Style="{StaticResource GroupCard}">
                    <VerticalStackLayout x:Name="Fields" />
                </Border>

                <Label Text="Names" Style="{StaticResource GroupLabel}" />
                <Border Style="{StaticResource GroupCard}">
                    <VerticalStackLayout x:Name="Names" />
                </Border>
                <Label x:Name="NamesCaption" Style="{StaticResource CardCaption}" />

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1">
            <BoxView HeightRequest="1" Color="{StaticResource Hairline}" />
            <Grid Padding="24,12" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Button Grid.Column="0" x:Name="AddNameButton" Text="Add a name"
                        Clicked="OnAddNameClicked" />
                <Button Grid.Column="1" Text="Delete" Clicked="OnDeleteClicked"
                        Style="{StaticResource DestructiveButton}" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
