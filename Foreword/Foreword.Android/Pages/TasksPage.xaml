<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Foreword.Android.Pages.TasksPage"
             Title="Tasks">
    <!--
        T3 in the mockups: one list, kinds marked.

        ONE LIST, NOT THREE. The kind is marked by BEHAVIOUR rather than origin — a rule repeats on a
        simple schedule, a smart task places itself, a once task happens and is gone — because where
        a task came from is not the interesting thing about it on a list. What it will do next
        morning is.

        THERE IS NO TICK HERE. Only the reMarkable closes a task: ticking happens on the printed
        checklist and nowhere else, so a task closed in Google's own app is shown STRUCK THROUGH
        rather than removed — the owner can see why it will not print, instead of wondering where it
        went.

        Mockups: https://claude.ai/code/artifact/6bb65b0d-04da-47f3-bf72-a04020217e0c
    -->
    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="{StaticResource ScreenPadding}" Spacing="0">

                <Label Text="Tasks" Style="{StaticResource DisplayLabel}" />

                <!-- The away line, when there is one. A caption rather than a banner: it is a fact
                     about the list, not a problem with it. -->
                <Label x:Name="AwayLabel" Style="{StaticResource CardCaption}" IsVisible="False" />

                <Border Style="{StaticResource GroupCard}" Margin="0,16,0,0">
                    <VerticalStackLayout x:Name="Rows" />
                </Border>

                <Label x:Name="EmptyLabel" Style="{StaticResource CardCaption}" IsVisible="False"
                       Text="Nothing yet. Everything that could print appears here — the rules you write and the tasks in Google." />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Pinned bottom bar (DESIGN.md §7). -->
        <VerticalStackLayout Grid.Row="1">
            <BoxView HeightRequest="1" Color="{StaticResource Hairline}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="24,12">
                <Button Grid.Column="0" Text="Add a task" Clicked="OnAddClicked" />
                <Button Grid.Column="1" Text="Away" Clicked="OnAwayClicked"
                        Style="{StaticResource QuietButton}" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
