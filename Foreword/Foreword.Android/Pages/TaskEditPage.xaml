<?xml version="1.0" encoding="utf-8" ?>
<pages:BinderPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Foreword.Android.Pages"
             x:Class="Foreword.Android.Pages.TaskEditPage"
             Title="Task">
    <!--
        T7 and T8 in the mockups — ONE screen. The form renders only the rows the kind actually uses:
        no window, no preferred day, no dry-hours stepper and no fallback rule for "vitamins every
        day", because a daily task has no window to place itself in.

        That is the answer to the objection against forms. A form that grows to the rule is fine; a
        form that shows every rule's controls to every task is not — it is the dozen controls with
        eleven blank that T6 exists to avoid.

        THERE IS NO SAVE. Every control commits as it changes (D35).

        Mockups: https://claude.ai/code/artifact/6bb65b0d-04da-47f3-bf72-a04020217e0c
    -->
    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="{StaticResource ScreenPadding}" Spacing="0">


                <Border Style="{StaticResource GroupCard}" Margin="0,16,0,0">
                    <VerticalStackLayout x:Name="Fields" />
                </Border>

                <Label x:Name="FootLabel" Style="{StaticResource CardCaption}" />

                <!-- Retyping is how a rule is CHANGED in kind: the form can move a Saturday to a
                     Sunday, but only the sentence can turn a daily rule into a smart one. -->
                <Button x:Name="RetypeButton" Text="Retype it in your own words"
                        Clicked="OnRetypeClicked" Style="{StaticResource QuietButton}"
                        HorizontalOptions="Start" Margin="0,16,0,0" />

                <Label x:Name="StatusLabel" Style="{StaticResource StatusLine}" IsVisible="False"
                       Margin="0,16,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1">
            <BoxView HeightRequest="1" Color="{StaticResource Hairline}" />
            <Grid Padding="24,12">
                <Button Text="Delete" Clicked="OnDeleteClicked"
                        Style="{StaticResource DestructiveButton}" HorizontalOptions="Start" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</pages:BinderPage>
