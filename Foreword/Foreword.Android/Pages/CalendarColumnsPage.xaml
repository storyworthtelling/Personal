<?xml version="1.0" encoding="utf-8" ?>
<pages:BinderPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Foreword.Android.Pages"
             x:Class="Foreword.Android.Pages.CalendarColumnsPage"
             Title="Columns">
    <!--
        The columns this account prints, set up here rather than written into the app. NOT IN THE
        APPROVED MOCKUP SET: the columns used to be a fixed list of the household's people in the
        code, which a public repository cannot carry. Built in RotationEditPage's grammar: one card of
        rows, Move rather than drag, a segmented control rather than a switch (§8), a pinned bottom
        bar, and no Save — every change commits as it is made.

        Removing a column is undo-first (§5): the rules that named it go with it, so the screen keeps
        what it removed until you leave and offers it back.

        Mockups: https://claude.ai/code/artifact/6bb65b0d-04da-47f3-bf72-a04020217e0c
    -->
    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="{StaticResource ScreenPadding}" Spacing="0">

                <Label Text="One column each, left to right as they print. Watch always prints last."
                       Style="{StaticResource CardCaption}" />

                <Label x:Name="StatusLabel" Style="{StaticResource StatusLine}" IsVisible="False" />
                <Button x:Name="UndoButton" Text="Put it back" IsVisible="False"
                        Style="{StaticResource QuietButton}" HorizontalOptions="Start"
                        Clicked="OnUndoClicked" />

                <Border Style="{StaticResource GroupCard}" Margin="0,16,0,0">
                    <VerticalStackLayout x:Name="Columns" />
                </Border>
                <Label Text="Own Google account means they can be invited, so an invitation to their address puts the event in their column. Anyone without one gets a calendar of their own, made for them."
                       Style="{StaticResource CardCaption}" />

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1">
            <BoxView HeightRequest="1" Color="{StaticResource Hairline}" />
            <Grid Padding="24,12">
                <Button Text="Add a column" Clicked="OnAddClicked" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</pages:BinderPage>
