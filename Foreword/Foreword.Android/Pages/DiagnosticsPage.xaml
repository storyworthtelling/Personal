<?xml version="1.0" encoding="utf-8" ?>
<pages:BinderPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Foreword.Android.Pages"
             x:Class="Foreword.Android.Pages.DiagnosticsPage"
             Title="Diagnostics">
    <!--
        S2 in the mockups. Copies Score's AudioDiagnosticsActivity exactly, so the suite has one
        diagnostics screen rather than one per app: a Serif page header, ONE body sentence, the
        rolling log as a single mono block inside a hairline card, oldest first, and a bottom bar
        of Copy / Share / Clear — two secondary buttons and a quiet one, no primary.

        It matters because there is no adb after the cutover. A background failure that nobody can
        reach is the thing this file exists to prevent, which is also why the empty state is a
        sentence rather than a blank card.

        Mockups: https://claude.ai/code/artifact/6bb65b0d-04da-47f3-bf72-a04020217e0c
    -->
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="{StaticResource ScreenPadding}" Spacing="16">


                <Label x:Name="IntroLabel" Style="{StaticResource SecondaryLabel}" />

                <Border x:Name="LogCard" Style="{StaticResource HairlineCard}" IsVisible="False">
                    <Label x:Name="LogLabel" Style="{StaticResource MonoLabel}" LineBreakMode="WordWrap" />
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1">
            <BoxView HeightRequest="1" Color="{StaticResource Hairline}" />
            <HorizontalStackLayout Padding="24,12" Spacing="8">
                <Button x:Name="CopyButton" Text="Copy" Style="{StaticResource SecondaryButton}"
                        Clicked="OnCopyClicked" />
                <Button x:Name="ShareButton" Text="Share" Style="{StaticResource SecondaryButton}"
                        Clicked="OnShareClicked" />
                <Button x:Name="ClearButton" Text="Clear" Style="{StaticResource QuietButton}"
                        Clicked="OnClearClicked" />
                <Button x:Name="SendLogsButton" Text="Send logs now" Style="{StaticResource SecondaryButton}"
                        Clicked="OnSendLogsNowClicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Grid>
</pages:BinderPage>
