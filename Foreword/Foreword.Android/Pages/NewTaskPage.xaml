<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Foreword.Android.Pages.NewTaskPage"
             Title="New task">
    <!--
        T6 in the mockups: adding one.

        ONE FIELD, AND NOTHING ELSE. The whole page is the sentence — no repeat picker, no season
        picker, no "needs N hours" stepper, and no worked examples either. An empty form able to
        express the lawn rule would carry a dozen controls, and eleven of them would sit blank for
        "vitamins every day". That form does exist — the edit screen — but only once there is a rule
        to fill it.

        READ IT BACK is the only action, because accepting happens on the NEXT screen: you never save
        something you have not seen parsed.

        Mockups: https://claude.ai/code/artifact/6bb65b0d-04da-47f3-bf72-a04020217e0c
    -->
    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="{StaticResource ScreenPadding}" Spacing="0">

                <Label Text="New task" Style="{StaticResource DisplayLabel}" />

                <Label Text="In your own words" Style="{StaticResource GroupLabel}" />
                <Border Style="{StaticResource GroupCard}">
                    <Editor x:Name="SentenceEditor"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="120"
                            Placeholder="mow the lawn once this weekend, saturday if it's dry, needs about three dry hours, april to october" />
                </Border>

                <Label Text="It reads this back before anything is saved."
                       Style="{StaticResource CardCaption}" />
                <Label Text="A one-off goes to Google Tasks. A rule stays in Foreword."
                       Style="{StaticResource CardCaption}" />

                <Label x:Name="StatusLabel" Style="{StaticResource StatusLine}" Margin="0,16,0,0"
                       IsVisible="False" />

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1">
            <BoxView HeightRequest="1" Color="{StaticResource Hairline}" />
            <Grid Padding="24,12">
                <Button x:Name="ReadButton" Text="Read it back" Clicked="OnReadClicked" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
