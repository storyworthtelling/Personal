<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Foreword.Android.Pages.CalendarColumnPage"
             Title="Calendar">
    <!--
        C2: which column one calendar feeds. Watch is the fifth column — games, fixtures and
        anything you follow rather than attend.

        Mockups: https://claude.ai/code/artifact/6bb65b0d-04da-47f3-bf72-a04020217e0c
    -->
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource ScreenPadding}" Spacing="0">

            <Label x:Name="NameLabel" Style="{StaticResource DisplayLabel}" />
            <Label Text="Where this calendar's events print."
                   Style="{StaticResource CardCaption}" />

            <Border Style="{StaticResource GroupCard}" Margin="0,16,0,0">
                <VerticalStackLayout x:Name="Choices" />
            </Border>

            <Label Text="Or sort it as it arrives" Style="{StaticResource GroupLabel}" />
            <Border Style="{StaticResource GroupCard}">
                <VerticalStackLayout x:Name="SplitRow" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
