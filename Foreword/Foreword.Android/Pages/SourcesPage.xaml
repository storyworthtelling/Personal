<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Foreword.Android.Pages.SourcesPage"
             Title="Sources">
    <!--
        T5 in the mockups: where the brief comes from.

        ARTICLE COUNTS ARE STEPPERS because they are the one number the owner actually tunes. Each
        feed carries its OWN cap rather than there being an overall one, so a noisy feed cannot crowd
        out a quiet one and a quiet morning still prints everything.

        A FEED IS NEVER UNSUBSCRIBED ON THE OWNER'S BEHALF, however long it fails. It stays on the
        list, still marked, until they remove it — a feed disappearing on its own is
        indistinguishable from a feed you forgot you added. The Trentonian is the real one, and it
        is why local news was dropped rather than why a row vanished.

        Mockups: https://claude.ai/code/artifact/6bb65b0d-04da-47f3-bf72-a04020217e0c
    -->
    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="{StaticResource ScreenPadding}" Spacing="0">

                <Label Text="Sources" Style="{StaticResource DisplayLabel}" />

                <Label Text="The paper" Style="{StaticResource GroupLabel}" />
                <Border Style="{StaticResource GroupCard}">
                    <VerticalStackLayout x:Name="Paper" />
                </Border>

                <Label Text="Feeds" Style="{StaticResource GroupLabel}" />
                <Border Style="{StaticResource GroupCard}">
                    <VerticalStackLayout x:Name="Feeds" />
                </Border>
                <Label x:Name="FeedsCaption" Style="{StaticResource CardCaption}" />

                <Label Text="xkcd prints whatever you have not seen. Nothing else is capped overall — only per feed."
                       Style="{StaticResource CardCaption}" />

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1">
            <BoxView HeightRequest="1" Color="{StaticResource Hairline}" />
            <Grid Padding="24,12">
                <Button Text="Add a feed" Clicked="OnAddFeedClicked" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
