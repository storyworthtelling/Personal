<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Foreword.Android.Pages.SetupPage"
             Title="Settings">
    <!--
        S1 in the mockups, built on Flyleaf's LauncherSettingsActivity furniture so the two
        screens are recognisably the same screen: a Serif group label over a hairline-ruled card,
        rows divided by hairlines, a Body title over a Label description, a chevron on anything
        that leads somewhere, and the quiet caption UNDER the card.

        Two rules shape what is here at all:

        A WORKING CREDENTIAL DOES NOT APPEAR. Not collapsed to a "Working" line — absent. The
        vault backs a key up and restores it, so a healthy one has nothing to ask and nothing to
        show; the row itself is the clutter. "Needs you" is a whole group that does not exist on
        a good morning.

        THERE IS NO SAVE. Every value commits as it changes, which is §5's inline state change
        and the rule Score gives for its own vault field: leaving by a tab never blurs anything,
        so a Save button is one that usually does nothing. Score's SettingsArea refuses those on
        principle, which is also why there is no "check for updates" and no "re-read calendars".

        Mockups: https://claude.ai/code/artifact/6bb65b0d-04da-47f3-bf72-a04020217e0c
    -->
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource ScreenPadding}" Spacing="0">

            <HorizontalStackLayout Spacing="12">
                <Image Source="owner_medallion.png" WidthRequest="48" HeightRequest="48"
                       VerticalOptions="Center" />
                <Label Text="Settings" Style="{StaticResource DisplayLabel}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- ==== Delivery ========================================================== -->
            <Label Text="Delivery" Style="{StaticResource GroupLabel}" />
            <Border Style="{StaticResource GroupCard}">
                <VerticalStackLayout>
                    <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Every morning at" Style="{StaticResource CardRowTitle}"
                               VerticalOptions="Center" />
                        <Label x:Name="DeliveryTimeLabel" Grid.Column="1" Style="{StaticResource CardRowValue}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource Hairline}" />
                    <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Goes to" Style="{StaticResource CardRowTitle}" />
                            <Label x:Name="DestinationLabel" Style="{StaticResource CardRowDescription}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="›" Style="{StaticResource CardRowChevron}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Label x:Name="LastDeliveryCaption" Style="{StaticResource CardCaption}" />

            <!-- ==== Needs you: absent unless something is actually broken ============== -->
            <Label x:Name="NeedsYouLabel" Text="Needs you" Style="{StaticResource GroupLabelProblem}"
                   IsVisible="False" />
            <Border x:Name="NeedsYouCard" Style="{StaticResource GroupCard}" IsVisible="False">
                <VerticalStackLayout x:Name="NeedsYouRows" />
            </Border>

            <!-- ==== Calendars ========================================================= -->
            <!--
                The JSON editor that used to sit in Advanced is GONE. It was a mono Editor where the
                owner hand-typed CalendarMappingOptions — opaque Google ids paired with column names,
                no validation, no way to know what you had. C1 replaces it with the real names, which
                cost no new API work: ListCalendars() already returned them and nothing had ever
                called it.
            -->
            <Label Text="Calendars" Style="{StaticResource GroupLabel}" />
            <Border Style="{StaticResource GroupCard}">
                <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCalendarsClicked" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Which calendar feeds which column" Style="{StaticResource CardRowTitle}" />
                        <Label x:Name="CalendarSummaryLabel" Style="{StaticResource CardRowDescription}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="›" Style="{StaticResource CardRowChevron}" />
                </Grid>
            </Border>

            <!-- ==== Weather & drives =================================================
                 One key for four Maps Platform APIs — routes, weather, pollen, air quality —
                 because Maps Platform bills a project rather than a product. The house is here
                 beside it because it is what every one of those calls needs: where the day starts
                 and where the forecast is. Shown in the clear rather than masked only for the
                 vault passphrase; this is a key, so it follows the masked rule.
            -->
            <Label Text="Weather &amp; drives" Style="{StaticResource GroupLabel}" />
            <Border Style="{StaticResource GroupCard}">
                <VerticalStackLayout>
                    <VerticalStackLayout x:Name="MapsKeyBlock" Padding="16,12" Spacing="8">
                        <Label Text="Google Maps Platform key" Style="{StaticResource CardRowTitle}" />
                        <Entry x:Name="MapsKeyEntry" Placeholder="Paste the key" TextChanged="OnMapsKeyChanged"
                               IsPassword="True" Style="{StaticResource MonoEntry}" />
                        <Label Text="Enable Routes, Weather, Pollen and Air Quality on the same project."
                               Style="{StaticResource CardRowDescription}" />
                    </VerticalStackLayout>

                    <Grid x:Name="MapsKeyWorkingRow" Padding="16,12" ColumnDefinitions="*,Auto"
                          IsVisible="False">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Maps key" Style="{StaticResource CardRowTitle}" />
                            <Label Text="Working ✓" Style="{StaticResource CardRowDescription}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Replace" Clicked="OnReplaceMapsKey"
                                Style="{StaticResource QuietButton}" />
                    </Grid>

                    <VerticalStackLayout Padding="16,12" Spacing="8">
                        <Label Text="Home" Style="{StaticResource CardRowTitle}" />
                        <Entry x:Name="HomeAddressEntry" Placeholder="Street, town" TextChanged="OnHomeAddressChanged"
                               Style="{StaticResource MonoEntry}" />
                        <Label Text="Every drive is measured from wherever that person's day has left them, and from here at the start of the morning."
                               Style="{StaticResource CardRowDescription}" />
                        <Entry x:Name="HomePointEntry" Placeholder="Latitude, longitude" TextChanged="OnHomePointChanged"
                               Style="{StaticResource MonoEntry}" />
                        <Label Text="The forecast needs a point rather than an address."
                               Style="{StaticResource CardRowDescription}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ==== Where it goes ===================================================== -->
            <Label Text="Where it goes" Style="{StaticResource GroupLabel}" />
            <Border Style="{StaticResource GroupCard}">
                <VerticalStackLayout>
                    <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="reMarkable" Style="{StaticResource CardRowTitle}" />
                            <Label x:Name="RemarkableStatusLabel" Style="{StaticResource CardRowDescription}" />
                        </VerticalStackLayout>
                        <Button x:Name="RemarkableReplaceButton" Grid.Column="1" Text="Pair"
                                Style="{StaticResource QuietButton}" Clicked="OnReplaceRemarkableClicked" />
                    </Grid>
                    <VerticalStackLayout x:Name="RemarkableFields" Padding="16,0,16,12" Spacing="8"
                                         IsVisible="False">
                        <Entry x:Name="RemarkableTokenEntry" Placeholder="One-time code"
                               Style="{StaticResource MonoEntry}" />
                        <Label Text="Visit my.remarkable.com/device/mobile/connect for a one-time code, then tap Register."
                               Style="{StaticResource SecondaryLabel}" />
                        <Button Text="Register reMarkable device" Style="{StaticResource SecondaryButton}"
                                Clicked="OnRegisterRemarkableClicked" />
                    </VerticalStackLayout>
                    <BoxView HeightRequest="1" Color="{StaticResource Hairline}" />
                    <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Google" Style="{StaticResource CardRowTitle}" />
                            <Label x:Name="GoogleStatusLabel" Style="{StaticResource CardRowDescription}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Sign in" Style="{StaticResource QuietButton}"
                                Clicked="OnGoogleSignInClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ==== Secrets vault ====================================================== -->
            <Label Text="Secrets vault" Style="{StaticResource GroupLabel}" />
            <Border Style="{StaticResource GroupCard}">
                <VerticalStackLayout Padding="16,12,16,16" Spacing="8">
                    <Label Text="Vault passphrase" Style="{StaticResource CardRowTitle}" />
                    <Label Text="The one secret that is not in the vault — set the same passphrase in every app and each restores its own keys. Shown in the clear on purpose, so it can be read back and copied."
                           Style="{StaticResource CardRowDescription}" />
                    <!-- Shown in the clear, never a password field: it has to be read back into the
                         other apps, and Android blocks clipboard copy on a password-typed entry. -->
                    <Entry x:Name="VaultPassphraseEntry" Placeholder="Choose a passphrase"
                           Style="{StaticResource MonoEntry}" TextChanged="OnVaultPassphraseChanged" />
                </VerticalStackLayout>
            </Border>

            <!-- ==== Advanced =========================================================== -->
            <Label Text="Advanced" Style="{StaticResource GroupLabel}" />
            <Border Style="{StaticResource GroupCard}">
                <VerticalStackLayout>
                    <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Send a test page to the reMarkable" Style="{StaticResource CardRowTitle}" />
                            <Label Text="One sheet, now" Style="{StaticResource CardRowDescription}" />
                        </VerticalStackLayout>
                        <Button x:Name="TestPageButton" Grid.Column="1" Text="Send"
                                Style="{StaticResource QuietButton}" Clicked="OnSendTestPageClicked" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource Hairline}" />
                    <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDiagnosticsClicked" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Diagnostics" Style="{StaticResource CardRowTitle}" />
                            <Label Text="Problems captured on this device" Style="{StaticResource CardRowDescription}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="›" Style="{StaticResource CardRowChevron}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- The quiet foot line: which build is actually on the phone. The update channel
                 installs silently and most updates change nothing visible, so without it
                 "did that land?" has no answer on the device. Matches Flyleaf's, via the one
                 shared Storyworthtelling.Updates.BuildLine formatter. -->
            <Label x:Name="BuildLineLabel"
                   Style="{StaticResource MonoLabel}"
                   HorizontalOptions="Center"
                   Margin="0,32,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
