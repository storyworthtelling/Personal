<?xml version="1.0" encoding="UTF-8" ?>
<!-- Paper & Ink design tokens and component styles. Mirrors DESIGN.md at the
     repo root; Foreword.Tests/Design/DesignTokenTests keeps the palette
     honest against the bible's values. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Palette -->
    <Color x:Key="Paper">#FAF8F2</Color>
    <Color x:Key="PaperBright">#FFFFFF</Color>
    <Color x:Key="PaperDeep">#F1EBDD</Color>
    <Color x:Key="PaperShade">#E9E1CF</Color>
    <Color x:Key="Hairline">#E3DCC9</Color>
    <Color x:Key="Ink">#33322B</Color>
    <Color x:Key="InkSoft">#6B6759</Color>
    <Color x:Key="InkMuted">#8A8578</Color>
    <Color x:Key="Accent">#C2542F</Color>
    <Color x:Key="AccentDeep">#9C4023</Color>

    <!-- Type scale, DESIGN.md §4's reworked ladder. Display and Title were 34 and 24 here,
         the pre-rework values: the bigger scale reached the native DesignTokens.TypeSp and
         never reached the MAUI dictionaries. Ledger's and Canonizer's still carry the old
         pair — a suite-wide divergence, reported rather than fixed here because those apps
         are outside this release. -->
    <x:Double x:Key="DisplaySize">44</x:Double>
    <x:Double x:Key="TitleSize">28</x:Double>
    <x:Double x:Key="HeadingSize">18</x:Double>
    <x:Double x:Key="BodySize">16</x:Double>
    <x:Double x:Key="SecondarySize">14</x:Double>
    <x:Double x:Key="LabelSize">13</x:Double>
    <x:Double x:Key="MonoSize">14</x:Double>

    <!-- Layout -->
    <Thickness x:Key="ScreenPadding">24</Thickness>

    <!-- Pages -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Paper}" />
    </Style>

    <!-- Text: default is Sans body ink; named styles cover the rest of the scale. -->
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>
    <Style x:Key="DisplayLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="SerifSemibold" />
        <Setter Property="FontSize" Value="{StaticResource DisplaySize}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>
    <Style x:Key="TitleLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="SerifSemibold" />
        <Setter Property="FontSize" Value="{StaticResource TitleSize}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>
    <Style x:Key="HeadingLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="SerifSemibold" />
        <Setter Property="FontSize" Value="{StaticResource HeadingSize}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>
    <Style x:Key="SecondaryLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="{StaticResource SecondarySize}" />
        <Setter Property="TextColor" Value="{StaticResource InkMuted}" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="SansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource LabelSize}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>
    <Style x:Key="MonoLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Mono" />
        <Setter Property="FontSize" Value="{StaticResource MonoSize}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>
    <Style x:Key="EmptyStateLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="SerifItalic" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="TextColor" Value="{StaticResource InkMuted}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>
    <Style x:Key="ErrorLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="{StaticResource SecondarySize}" />
        <Setter Property="TextColor" Value="{StaticResource AccentDeep}" />
    </Style>

    <!-- Buttons: primary by default; one per screen at most. -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="SansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource LabelSize}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="TextColor" Value="{StaticResource PaperBright}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="SansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource LabelSize}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Paper}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="BorderColor" Value="{StaticResource Hairline}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>
    <Style x:Key="QuietButton" TargetType="Button">
        <Setter Property="FontFamily" Value="SansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource LabelSize}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource InkMuted}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>
    <Style x:Key="DestructiveButton" TargetType="Button">
        <Setter Property="FontFamily" Value="SansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource LabelSize}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Paper}" />
        <Setter Property="TextColor" Value="{StaticResource Accent}" />
        <Setter Property="BorderColor" Value="{StaticResource Accent}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <!-- Inputs -->
    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="BackgroundColor" Value="{StaticResource PaperBright}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource InkMuted}" />
    </Style>
    <Style x:Key="MonoEntry" TargetType="Entry">
        <Setter Property="FontFamily" Value="Mono" />
        <Setter Property="FontSize" Value="{StaticResource MonoSize}" />
        <Setter Property="BackgroundColor" Value="{StaticResource PaperDeep}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource InkMuted}" />
    </Style>

    <!-- The same mono treatment for a multi-line Editor. A Style's TargetType must match the
         control exactly: MonoEntry on an Editor throws at runtime, and only at runtime. -->
    <Style x:Key="MonoEditor" TargetType="Editor">
        <Setter Property="FontFamily" Value="Mono" />
        <Setter Property="FontSize" Value="{StaticResource MonoSize}" />
        <Setter Property="BackgroundColor" Value="{StaticResource PaperDeep}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource InkMuted}" />
    </Style>

    <!-- Cards -->
    <!-- Settings furniture, matching Flyleaf's LauncherSettingsActivity so the two screens are
         the same screen. StartGroup writes a Serif SemiBold label at Body size over a
         hairline-ruled card; BeginRow rules a hairline above every row but the first;
         AddCardRow is a Body title over a Label description; AddCardCaption is the quiet
         Label sentence UNDER the card. -->
    <Style x:Key="GroupLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="SerifSemibold" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="Margin" Value="0,24,0,8" />
    </Style>

    <!-- The same label in the problem hue: the "Needs you" group, which simply does not exist
         on a morning when nothing is broken. -->
    <Style x:Key="GroupLabelProblem" TargetType="Label" BasedOn="{StaticResource GroupLabel}">
        <Setter Property="TextColor" Value="{StaticResource Accent}" />
    </Style>

    <Style x:Key="GroupCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource PaperBright}" />
        <Setter Property="Stroke" Value="{StaticResource Hairline}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="CardRowTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>

    <Style x:Key="CardRowDescription" TargetType="Label">
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="{StaticResource LabelSize}" />
        <Setter Property="TextColor" Value="{StaticResource InkMuted}" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style x:Key="CardRowValue" TargetType="Label">
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- AddNavRow's chevron: a row that leads somewhere says so. -->
    <Style x:Key="CardRowChevron" TargetType="Label" BasedOn="{StaticResource CardRowValue}">
        <Setter Property="TextColor" Value="{StaticResource InkMuted}" />
    </Style>

    <Style x:Key="CardCaption" TargetType="Label">
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="{StaticResource LabelSize}" />
        <Setter Property="TextColor" Value="{StaticResource InkMuted}" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <Style x:Key="HairlineCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource PaperBright}" />
        <Setter Property="Stroke" Value="{StaticResource Hairline}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="WarningCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource PaperDeep}" />
        <Setter Property="Stroke" Value="{StaticResource Accent}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <!-- Chips: phase progress and problems (DESIGN.md §7) -->
    <Style x:Key="PhaseChip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Paper}" />
        <Setter Property="Stroke" Value="{StaticResource Hairline}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="8,2" />
    </Style>
    <Style x:Key="ErrorChip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource PaperBright}" />
        <Setter Property="Stroke" Value="{StaticResource Accent}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="8,2" />
    </Style>
    <Style x:Key="ChipLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="{StaticResource LabelSize}" />
        <Setter Property="TextColor" Value="{StaticResource InkMuted}" />
    </Style>
    <Style x:Key="ChipLabelActive" TargetType="Label">
        <Setter Property="FontFamily" Value="SansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource LabelSize}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>
    <Style x:Key="ChipLabelError" TargetType="Label">
        <Setter Property="FontFamily" Value="SansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource LabelSize}" />
        <Setter Property="TextColor" Value="{StaticResource AccentDeep}" />
    </Style>

    <!-- The loading voice: one quiet sentence, updated in place (DESIGN.md §5) -->
    <Style x:Key="StatusLine" TargetType="Label">
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="{StaticResource SecondarySize}" />
        <Setter Property="TextColor" Value="{StaticResource InkMuted}" />
    </Style>

    <!-- Progress -->
    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Accent}" />
    </Style>
</ResourceDictionary>
