<?xml version="1.0" encoding="UTF-8" ?>
<!-- The Paper & Ink role table and component styles for every MAUI head — the MAUI half of what
     Codex.Ui.Android's PaperUi/PaperTheme are for the native ones. A REGISTERED TOKEN FILE
     (DESIGN.md §16): colour hexes and type sizes may appear here and nowhere else on this side of
     the suite.

     Storyworthtelling.Maui.Tests checks it against Storyworthtelling.Paper's GENERATED tokens by
     reflection rather than against a table typed into the test. That distinction is the reason this
     file exists: each MAUI head used to keep its own copy of the palette and its own test holding a
     second copy of the same values, so both could be wrong together — and were, for as long as
     nobody put two of the apps side by side. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="Storyworthtelling.Maui.PaperKit">

    <!-- Palette -->
    <Color x:Key="Paper">#FAF8F2</Color>
    <Color x:Key="PaperBright">#FFFFFF</Color>
    <Color x:Key="PaperDeep">#F1EBDD</Color>
    <Color x:Key="PaperShade">#E9E1CF</Color>
    <Color x:Key="Hairline">#E3DCC9</Color>
    <Color x:Key="Ink">#33322B</Color>
    <Color x:Key="InkSoft">#6B6759</Color>
    <Color x:Key="InkMuted">#8A8578</Color>
    <!-- The Action role (pine). DESIGN.md §4 retires terracotta EVERYWHERE and §3 makes the accent
         a semantic role rather than a decoration; the native heads moved at their rebrand phases and
         the MAUI heads did not, so every button in all three was still #C2542F. PaperColorTokens
         keeps the old Accent constant so existing renderers do not break, which is exactly why the
         name alone could not be trusted to say which value was current. -->
    <Color x:Key="Accent">#38734A</Color>
    <Color x:Key="AccentDeep">#174025</Color>

    <!-- "The pen": signatures, editorial marks, and the colour of the owner's voice. -->
    <Color x:Key="InkBlue">#2C3E5E</Color>

    <!-- The mark tier of the roles a dog-ear can carry (DESIGN.md §3). Only the six the fold
         actually names (Reference and Progress joined for mockup 17's Waiting page): a role in the dictionary that nothing draws is a colour waiting to be
         misused. The palette guard checks each of these against PaperColorTokens by name. -->
    <Color x:Key="ProblemMark">#9E434B</Color>
    <Color x:Key="CautionMark">#805F00</Color>
    <Color x:Key="ResolvedMark">#68645E</Color>
    <Color x:Key="ActionMark">#38734A</Color>
    <Color x:Key="ReferenceMark">#4C6787</Color>
    <Color x:Key="ProgressMark">#18717C</Color>

    <!-- The fill tier, which §9's binder strip needs and nothing else does: the coloured cloth an
         INACTIVE tab is cut from. Only the three the strip actually cuts a tab out of — an area
         whose tab carries the app's identity hue takes that from the head, not from here. -->
    <Color x:Key="ActionFill">#A5C8AD</Color>
    <Color x:Key="ReferenceFill">#AEC0D5</Color>
    <Color x:Key="ResolvedFill">#C0BDB9</Color>

    <!-- The wash tier: the mark at PaperColorTokens.WashAlpha (77 of 255 = 4D), which is what §8's
         Selected state paints behind full-strength ink. Written as ARGB rather than mixed in code
         so it stays inside the token file — and the palette guard composes it from the mark and the
         alpha rather than trusting the eight digits. -->
    <Color x:Key="ActionWash">#4D38734A</Color>

    <!-- Type scale, DESIGN.md §4's reworked ladder, kept in step with the native DesignTokens.TypeSp
         by a test that reads that file rather than restating it. Display and Title were 34 and 24 in
         the MAUI dictionaries: the reworked, bigger scale reached the native tokens and never
         crossed over. Ledger's and Canonizer's private dictionaries still carry the old pair; they
         adopt the kit at their own phases. -->
    <x:Double x:Key="DisplaySize">44</x:Double>
    <x:Double x:Key="TitleSize">28</x:Double>
    <x:Double x:Key="HeadingSize">18</x:Double>
    <x:Double x:Key="BodySize">16</x:Double>
    <x:Double x:Key="SecondarySize">14</x:Double>
    <x:Double x:Key="LabelSize">13</x:Double>
    <x:Double x:Key="MonoSize">14</x:Double>
    <x:Double x:Key="VoiceSize">26</x:Double>

    <!-- Layout -->
    <Thickness x:Key="ScreenPadding">24</Thickness>

    <!-- Pages -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Paper}" />
    </Style>

    <!-- Text: default is Sans body ink; named styles cover the rest of the scale. -->
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>
    <!-- Serif BLACK, the face DESIGN.md §4 reserves for every screen header. The MAUI heads drew it
         in Semibold, which was not a choice: Source Serif 4 Black is one of the two faces in /Fonts
         that shipped inside every APK with no alias registered for it, so it was unreachable and
         nothing said so. -->
    <Style x:Key="DisplayLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="SerifBlack" />
        <Setter Property="FontSize" Value="{StaticResource DisplaySize}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>
    <Style x:Key="TitleLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="SerifSemibold" />
        <Setter Property="FontSize" Value="{StaticResource TitleSize}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>
    <Style x:Key="HeadingLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="SerifSemibold" />
        <Setter Property="FontSize" Value="{StaticResource HeadingSize}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>
    <Style x:Key="SecondaryLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="{StaticResource SecondarySize}" />
        <Setter Property="TextColor" Value="{StaticResource InkMuted}" />
    </Style>
    <!-- The Label role: Sans Semibold at 13 in the MUTED ink. It carried the full ink here, which
         reads as a slightly heavy screen rather than as a mistake — the quietest kind of drift. -->
    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="SansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource LabelSize}" />
        <Setter Property="TextColor" Value="{StaticResource InkMuted}" />
    </Style>
    <Style x:Key="MonoLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Mono" />
        <Setter Property="FontSize" Value="{StaticResource MonoSize}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>
    <Style x:Key="EmptyStateLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="SerifItalic" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="TextColor" Value="{StaticResource InkMuted}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>
    <!-- The owner's voice: Pinyon Script at 26 in the pen's blue. The ninth role, and the only one
         with no style anywhere in MAUI — Pinyon shipped in every APK unregistered, so an app that
         wanted to speak in the owner's hand had nothing to ask for. -->
    <Style x:Key="VoiceLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Script" />
        <Setter Property="FontSize" Value="{StaticResource VoiceSize}" />
        <Setter Property="TextColor" Value="{StaticResource InkBlue}" />
    </Style>
    <Style x:Key="ErrorLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="{StaticResource SecondarySize}" />
        <Setter Property="TextColor" Value="{StaticResource AccentDeep}" />
    </Style>

    <!-- Buttons: primary by default; one per screen at most. -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="SansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource LabelSize}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="TextColor" Value="{StaticResource PaperBright}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="SansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource LabelSize}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Paper}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="BorderColor" Value="{StaticResource Hairline}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>
    <Style x:Key="QuietButton" TargetType="Button">
        <Setter Property="FontFamily" Value="SansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource LabelSize}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource InkMuted}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>
    <Style x:Key="DestructiveButton" TargetType="Button">
        <Setter Property="FontFamily" Value="SansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource LabelSize}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Paper}" />
        <Setter Property="TextColor" Value="{StaticResource Accent}" />
        <Setter Property="BorderColor" Value="{StaticResource Accent}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <!-- Inputs -->
    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="BackgroundColor" Value="{StaticResource PaperBright}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource InkMuted}" />
    </Style>
    <Style x:Key="MonoEntry" TargetType="Entry">
        <Setter Property="FontFamily" Value="Mono" />
        <Setter Property="FontSize" Value="{StaticResource MonoSize}" />
        <Setter Property="BackgroundColor" Value="{StaticResource PaperDeep}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource InkMuted}" />
    </Style>

    <!-- The same mono treatment for a multi-line Editor. A Style's TargetType must match the
         control exactly: MonoEntry on an Editor throws at runtime, and only at runtime. -->
    <Style x:Key="MonoEditor" TargetType="Editor">
        <Setter Property="FontFamily" Value="Mono" />
        <Setter Property="FontSize" Value="{StaticResource MonoSize}" />
        <Setter Property="BackgroundColor" Value="{StaticResource PaperDeep}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource InkMuted}" />
    </Style>

    <!-- Cards -->
    <!-- Settings furniture, matching Flyleaf's LauncherSettingsActivity so the two screens are
         the same screen. StartGroup writes a Serif SemiBold label at Body size over a
         hairline-ruled card; BeginRow rules a hairline above every row but the first;
         AddCardRow is a Body title over a Label description; AddCardCaption is the quiet
         Label sentence UNDER the card. -->
    <Style x:Key="GroupLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="SerifSemibold" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="Margin" Value="0,24,0,8" />
    </Style>

    <!-- The same label in the problem hue: the "Needs you" group, which simply does not exist
         on a morning when nothing is broken. -->
    <Style x:Key="GroupLabelProblem" TargetType="Label" BasedOn="{StaticResource GroupLabel}">
        <Setter Property="TextColor" Value="{StaticResource Accent}" />
    </Style>

    <Style x:Key="GroupCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource PaperBright}" />
        <Setter Property="Stroke" Value="{StaticResource Hairline}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="CardRowTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>

    <Style x:Key="CardRowDescription" TargetType="Label">
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="{StaticResource LabelSize}" />
        <Setter Property="TextColor" Value="{StaticResource InkMuted}" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style x:Key="CardRowValue" TargetType="Label">
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- AddNavRow's chevron: a row that leads somewhere says so. -->
    <Style x:Key="CardRowChevron" TargetType="Label" BasedOn="{StaticResource CardRowValue}">
        <Setter Property="TextColor" Value="{StaticResource InkMuted}" />
    </Style>

    <Style x:Key="CardCaption" TargetType="Label">
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="{StaticResource LabelSize}" />
        <Setter Property="TextColor" Value="{StaticResource InkMuted}" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <Style x:Key="HairlineCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource PaperBright}" />
        <Setter Property="Stroke" Value="{StaticResource Hairline}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="WarningCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource PaperDeep}" />
        <Setter Property="Stroke" Value="{StaticResource Accent}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <!-- Chips: phase progress and problems (DESIGN.md §7) -->
    <Style x:Key="PhaseChip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Paper}" />
        <Setter Property="Stroke" Value="{StaticResource Hairline}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="8,2" />
    </Style>
    <Style x:Key="ErrorChip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource PaperBright}" />
        <Setter Property="Stroke" Value="{StaticResource Accent}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="8,2" />
    </Style>
    <Style x:Key="ChipLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="{StaticResource LabelSize}" />
        <Setter Property="TextColor" Value="{StaticResource InkMuted}" />
    </Style>
    <Style x:Key="ChipLabelActive" TargetType="Label">
        <Setter Property="FontFamily" Value="SansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource LabelSize}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>
    <!-- Segmented control (DESIGN.md §8): named options in one row, the picked one washed.
         SemiBold is set on the picked segment at run time, so this is the resting face. -->
    <Style x:Key="SegmentLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="{StaticResource LabelSize}" />
        <Setter Property="TextColor" Value="{StaticResource InkMuted}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="ChipLabelError" TargetType="Label">
        <Setter Property="FontFamily" Value="SansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource LabelSize}" />
        <Setter Property="TextColor" Value="{StaticResource AccentDeep}" />
    </Style>

    <!-- The loading voice: one quiet sentence, updated in place (DESIGN.md §5) -->
    <Style x:Key="StatusLine" TargetType="Label">
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="{StaticResource SecondarySize}" />
        <Setter Property="TextColor" Value="{StaticResource InkMuted}" />
    </Style>

    <!-- Progress -->
    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Accent}" />
    </Style>
</ResourceDictionary>
