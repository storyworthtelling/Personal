<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NytRemarkable.Android.Pages.MainPage"
             Title="NYT Crossword Delivery"
             BackgroundColor="{StaticResource PageBackground}">
    <VerticalStackLayout Padding="24" Spacing="20" VerticalOptions="Center">

        <Label Text="NYT Crossword Delivery"
               FontSize="24" FontAttributes="Bold"
               TextColor="{StaticResource TextPrimary}"
               HorizontalOptions="Center" />

        <Label x:Name="StatusLabel"
               FontSize="14"
               TextColor="{StaticResource TextSecondary}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center" />

        <Label x:Name="ConfigWarningLabel"
               Text="⚠ Credentials not configured. Go to Settings."
               FontSize="13"
               TextColor="#ffcc00"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               IsVisible="False" />

        <Button x:Name="DeliverNowButton"
                Text="Deliver Now"
                Clicked="OnDeliverNowClicked"
                HorizontalOptions="Fill" />

        <ActivityIndicator x:Name="Spinner"
                           IsRunning="False"
                           IsVisible="False"
                           Color="{StaticResource Accent}"
                           HorizontalOptions="Center" />

        <Button Text="Settings"
                Clicked="OnSettingsClicked"
                BackgroundColor="#333333"
                HorizontalOptions="Fill" />

        <Button x:Name="DeliveryLogButton"
                Text="View Delivery Log"
                Clicked="OnDeliveryLogClicked"
                BackgroundColor="#1a3a5a"
                IsVisible="False"
                HorizontalOptions="Fill" />

        <Button x:Name="CrashLogButton"
                Text="View Crash Log"
                Clicked="OnCrashLogClicked"
                BackgroundColor="#5a1a1a"
                IsVisible="False"
                HorizontalOptions="Fill" />

    </VerticalStackLayout>
</ContentPage>
