<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The log loop's reader (LOG-LOOP-PLAN.md §5, §6.1, §6.3), run by the weekly cloud session and by CI:
      fetch     download and decrypt the week's batches with the read-only Drive token, outside the repo
      digest    group what was logged by fingerprint, so triage reads a summary before raw lines
      sanitize  the only path from a log line to a PR or an issue
      leakscan  block a diff, PR title or body that carries anything from the week's plaintext; and the
                content-free subset CI runs on every claude/** push
      gate      decide whether a claude/logfix-* PR is a log-derived bug fix that may auto-merge
    Sealing and the batch shape come from the apps' own libraries, so the reader and the phones cannot drift.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>LogLoopReader</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Storyworthtelling.Diagnostics\Storyworthtelling.Diagnostics.csproj" />
    <ProjectReference Include="..\..\Storyworthtelling.Voice\Storyworthtelling.Voice.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LogLoopReader.Tests" />
  </ItemGroup>
</Project>
