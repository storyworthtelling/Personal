<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Reads the worksheet PDF back to prove VectorPdfSink produced real, extractable vector text
         here — the same reader Folio/Foreword/Storyworthtelling.Paper's own suites already use. -->
    <PackageReference Include="PdfPig" Version="0.1.10" />
    <!-- The desktop test host needs the native Skia binary to run VectorPdfSink at all (the Android
         head gets its own via SkiaSharp.Views.Android at build time) — same package
         Storyworthtelling.Paper.Tests already references for the identical reason. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The INVENTED Debt Snowball history the import tests run against: same shape as the file the owner
       seals into their own Drive, every name and figure made up. The real one never enters the repo. -->
  <ItemGroup>
    <EmbeddedResource Include="Snowball\Fixtures\synthetic-snowball-history.json"
                      LogicalName="Index.Tests.Snowball.synthetic-snowball-history.json" />
  </ItemGroup>

  <!-- G7's expected table, generated by Snowball\Oracle\sheet_oracle.py (an independent Python
       implementation of the sheet's documented formulas, from invented inputs). Embedded so the test
       needs no Python at run time; regenerate with the command at the top of the oracle. -->
  <ItemGroup>
    <EmbeddedResource Include="Snowball\Oracle\sheet_expected.json"
                      LogicalName="Index.Tests.Snowball.sheet_expected.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ledger.Domain\Ledger.Domain.csproj" />
    <ProjectReference Include="..\Ledger.Infrastructure\Ledger.Infrastructure.csproj" />
  </ItemGroup>

</Project>
