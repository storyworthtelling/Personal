<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application android:allowBackup="true" android:icon="@mipmap/appicon"
               android:roundIcon="@mipmap/appicon_round"
               android:label="Index" android:supportsRtl="true">
  </application>
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- Required for WorkManager on API 33+ -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Package visibility (Android 11+). The connect page asks whether Chrome is suspended, which is
       how it tells that the FocusPhone's Admin mode is open (the default browser stays Flyleaf's
       restricted viewer either way, so it cannot). Without the <package> entry Android hides Chrome
       from this app and PackageManager reports it as not installed. -->
  <queries>
    <package android:name="com.android.chrome" />
    <!-- Constitution (budget contract): the sender asks whether it is installed before it broadcasts. -->
    <package android:name="com.storyworthtelling.constitution" />
    <!-- Plate (statement read): an account's post-it starts Plate's reading screen by name. -->
    <package android:name="com.storyworthtelling.focusphone.camera" />
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <category android:name="android.intent.category.BROWSABLE" />
      <data android:scheme="https" />
    </intent>
  </queries>
</manifest>
