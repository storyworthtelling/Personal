<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ledger.Android.Pages.SetupPage"
             Title="Settings">
    <Grid RowDefinitions="*,Auto">
    <ScrollView Grid.Row="0">
        <VerticalStackLayout Padding="{StaticResource ScreenPadding}" Spacing="14">

            <HorizontalStackLayout Spacing="12">
                <Image Source="owner_medallion.png" WidthRequest="48" HeightRequest="48"
                       VerticalOptions="Center" />
                <Label Text="Settings" Style="{StaticResource DisplayLabel}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Border x:Name="MigrationErrorCard" IsVisible="False" Style="{StaticResource WarningCard}" Margin="0,8,0,0">
                <Label x:Name="MigrationErrorLabel" FontSize="{StaticResource SecondarySize}" />
            </Border>

            <Label Text="Plaid credentials" Style="{StaticResource TitleLabel}" Margin="0,8,0,0" />

            <Label Text="Client ID" Style="{StaticResource FieldLabel}" />
            <Entry x:Name="ClientIdEntry" Placeholder="6f1a…" Style="{StaticResource MonoEntry}" />

            <Label Text="Secret" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
            <Entry x:Name="SecretEntry" Placeholder="••••••••" IsPassword="True" Style="{StaticResource MonoEntry}" />

            <Label Text="Environment" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
            <Picker x:Name="EnvironmentPicker">
                <Picker.Items>
                    <x:String>sandbox</x:String>
                    <x:String>production</x:String>
                </Picker.Items>
            </Picker>
            <Label Text="From dashboard.plaid.com → Team Settings → Keys. Start in sandbox to test, then switch to production for real accounts."
                   Style="{StaticResource SecondaryLabel}" />

            <BoxView HeightRequest="1" Color="{StaticResource Hairline}" Margin="0,12" />

            <Label Text="Secrets vault" Style="{StaticResource TitleLabel}" />
            <Label Text="A passphrase encrypts one shared file in your Google Drive that holds every app's keys — here, your Plaid credentials and each connected bank's access token. Set the same passphrase in each app; after a factory reset or reinstall, sign in with Google below and your banks restore automatically. Needs the Google sign-in below."
                   Style="{StaticResource SecondaryLabel}" />
            <Label Text="Vault passphrase" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
            <Entry x:Name="VaultPassphraseEntry" IsPassword="True" Placeholder="Choose a passphrase"
                   Style="{StaticResource MonoEntry}" />

            <BoxView HeightRequest="1" Color="{StaticResource Hairline}" Margin="0,12" />

            <Label Text="Connected accounts" Style="{StaticResource TitleLabel}" />
            <Label x:Name="NoAccountsLabel" Text="Nothing connected yet."
                   Style="{StaticResource SecondaryLabel}" />
            <VerticalStackLayout x:Name="ConnectedList" Spacing="6"
                                 BindableLayout.ItemsSource="{Binding .}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Name}" Style="{StaticResource HeadingLabel}" />
                                <Label Text="{Binding Summary}" Style="{StaticResource SecondaryLabel}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Remove" Style="{StaticResource DestructiveButton}"
                                    Clicked="OnRemoveClicked" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Undo-first removal (DESIGN.md §7): the row goes immediately; this bar self-dismisses. -->
            <Border x:Name="UndoBar" IsVisible="False" Style="{StaticResource HairlineCard}" Padding="16,10">
                <Grid ColumnDefinitions="*,Auto">
                    <Label x:Name="UndoLabel" Grid.Column="0" Style="{StaticResource SecondaryLabel}"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Undo" Style="{StaticResource QuietButton}"
                            Clicked="OnUndoClicked" />
                </Grid>
            </Border>

            <Button x:Name="ConnectButton" Text="Connect an account"
                    Clicked="OnConnectClicked" Style="{StaticResource SecondaryButton}" Margin="0,4,0,0" />
            <Label x:Name="ConnectStatusLabel" Style="{StaticResource StatusLine}" />

            <BoxView HeightRequest="1" Color="{StaticResource Hairline}" Margin="0,12" />

            <Label Text="Diagnostics" Style="{StaticResource TitleLabel}" />
            <Label Text="Share the refresh log to see what each institution is doing and what went wrong."
                   Style="{StaticResource SecondaryLabel}" />
            <Button Text="Share refresh log" Clicked="OnShareLogClicked" Style="{StaticResource SecondaryButton}" />
            <Label x:Name="DiagnosticsStatusLabel" Style="{StaticResource StatusLine}" />

            <BoxView HeightRequest="1" Color="{StaticResource Hairline}" Margin="0,12" />

            <Label Text="Google account" Style="{StaticResource TitleLabel}" />
            <Label Text="Sign in with Google to back up your keys to the secrets vault and to greet you in your own voice from your shared Drive profile. Skip it to keep neutral copy and local-only settings."
                   Style="{StaticResource SecondaryLabel}" />
            <Button x:Name="VoiceSignInButton" Text="Sign in with Google"
                    Clicked="OnVoiceSignInClicked" Style="{StaticResource SecondaryButton}" />
            <Label x:Name="VoiceStatusLabel" Style="{StaticResource StatusLine}" />

        </VerticalStackLayout>
    </ScrollView>

    <!-- Pinned bottom bar (DESIGN.md §7). -->
    <VerticalStackLayout Grid.Row="1">
        <BoxView HeightRequest="1" Color="{StaticResource Hairline}" />
        <Grid Padding="24,12">
            <Button Text="Save settings" Clicked="OnSaveClicked" />
        </Grid>
    </VerticalStackLayout>
    </Grid>
</ContentPage>
