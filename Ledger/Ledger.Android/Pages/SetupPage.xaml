<?xml version="1.0" encoding="utf-8" ?>
<pages:LedgerBinderPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Index.Android.Pages"
             x:Class="Index.Android.Pages.SetupPage">
    <!-- The header and the binder strip come from LedgerBinderPage; this is the well between them.
         Mockup 10 draws this screen with no pinned bar: every field saves itself. ClientIdEntry,
         SecretEntry and VaultPassphraseEntry commit when they are left (see the code-behind's
         CommitSettingsAsync); the toggle and the categories already wrote through as they changed.
         The role-dependent words (vault, Google account) are set from the Domain's SettingsCopy, so
         her install (mockup 11) and the owner's read from one table. -->
    <ScrollView x:Name="PageScroll">
        <VerticalStackLayout Padding="{StaticResource ScreenPadding}" Spacing="14">

            <Border x:Name="MigrationErrorCard" IsVisible="False" Style="{StaticResource WarningCard}">
                <Label x:Name="MigrationErrorLabel" FontSize="{StaticResource SecondarySize}" />
            </Border>

            <!-- ==================== Plaid ====================
                 D09: hidden entirely (not shown-and-disabled) on her install — no Plaid keys anywhere
                 in her Settings. Wrapped so OnAppearing can hide the whole group in one line. -->
            <VerticalStackLayout x:Name="PlaidSection" Spacing="14">
                <Label Text="Plaid credentials" Style="{StaticResource TitleLabel}" Margin="0,8,0,0" />
                <Label Text="Working credentials stay put — they're backed up to the vault and restored automatically, so these fields only appear when they're missing or Plaid just rejected them."
                       Style="{StaticResource SecondaryLabel}" />

                <Grid x:Name="PlaidStatusRow" ColumnDefinitions="*,Auto" IsVisible="False" Margin="0,4,0,0">
                    <Label x:Name="PlaidStatusLabel" Grid.Column="0" VerticalOptions="Center"
                           Style="{StaticResource SecondaryLabel}" />
                    <Button x:Name="PlaidReplaceButton" Grid.Column="1" Text="Replace"
                            Style="{StaticResource QuietButton}" Clicked="OnReplacePlaidClicked" />
                </Grid>

                <VerticalStackLayout x:Name="PlaidCredentialFields" Spacing="14" IsVisible="False">
                    <Label Text="Client ID" Style="{StaticResource FieldLabel}" />
                    <Entry x:Name="ClientIdEntry" Placeholder="6f1a…" Style="{StaticResource MonoEntry}" />

                    <Label Text="Secret" Style="{StaticResource FieldLabel}" />
                    <Entry x:Name="SecretEntry" Placeholder="••••••••" IsPassword="True" Style="{StaticResource MonoEntry}" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <BoxView x:Name="PlaidDivider" HeightRequest="1" Color="{StaticResource Hairline}" Margin="0,12" />

            <!-- ==================== Shared keys (D80) ====================
                 Not in mockup 11's own Settings list either — she signs in with her own Google account
                 but reads no shared-key status of her own (D36: "only the vault passphrase field and
                 her Google account sign-in"). -->
            <VerticalStackLayout x:Name="SharedKeysSection" Spacing="4">
                <Label Text="Shared keys" Style="{StaticResource TitleLabel}" />
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Claude, for the voice" Style="{StaticResource FieldLabel}" />
                        <Label x:Name="SharedKeyStatusLabel" Style="{StaticResource SecondaryLabel}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="Set in Folio" VerticalOptions="Center"
                           Style="{StaticResource SecondaryLabel}" />
                </Grid>
            </VerticalStackLayout>

            <BoxView x:Name="SharedKeysDivider" HeightRequest="1" Color="{StaticResource Hairline}" Margin="0,12" />

            <!-- ==================== Vault ==================== -->
            <Label x:Name="VaultHeadingLabel" Style="{StaticResource TitleLabel}" />
            <Label x:Name="VaultIntroLabel" Style="{StaticResource SecondaryLabel}" />
            <Label Text="Vault passphrase" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
            <Entry x:Name="VaultPassphraseEntry" Placeholder="Choose a passphrase"
                   Style="{StaticResource MonoEntry}" />
            <Label x:Name="PassphraseNoteLabel" Style="{StaticResource SecondaryLabel}" />

            <BoxView HeightRequest="1" Color="{StaticResource Hairline}" Margin="0,12" />

            <!-- ==================== Connected accounts ====================
                 Not part of mockup 10 (banks now live on their own cards in Accounts, D144's note) —
                 kept here, out of the mockup's section order, until Release C's Accounts/connect
                 screens (mockups 2/4/5) give this its own home. Removing it now would leave no way
                 to connect or remove a bank at all.
                 D09: hidden entirely on her install (no connect flow, no Plaid-shaped anything). The
                 UndoBar below lives in this wrapper too — the only two things it ever serves
                 (an institution removal, a Budget category removal) are both owner-only actions, so
                 hiding it alongside them is correct, not incidental. (A Budget category's undo is NOT
                 served by it any more: that one is the dog-ear, which stays in view wherever the
                 category was removed.) -->
            <VerticalStackLayout x:Name="ConnectedAccountsSection" Spacing="10">
                <Label Text="Connected accounts" Style="{StaticResource TitleLabel}" />
                <Label x:Name="NoAccountsLabel" Text="Nothing connected yet."
                       Style="{StaticResource SecondaryLabel}" />
                <VerticalStackLayout x:Name="ConnectedList" Spacing="6"
                                     BindableLayout.ItemsSource="{Binding .}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" Style="{StaticResource HeadingLabel}" />
                                    <Label Text="{Binding Summary}" Style="{StaticResource SecondaryLabel}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="Remove" Style="{StaticResource DestructiveButton}"
                                        Clicked="OnRemoveClicked" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Undo-first removal (DESIGN.md §7): the row goes immediately; this bar self-dismisses.
                     Serves the institution removal only, which happens in this section, right above it. -->
                <Border x:Name="UndoBar" IsVisible="False" Style="{StaticResource HairlineCard}" Padding="16,10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="UndoLabel" Grid.Column="0" Style="{StaticResource SecondaryLabel}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Undo" Style="{StaticResource QuietButton}"
                                Clicked="OnUndoClicked" />
                    </Grid>
                </Border>

                <Button x:Name="ConnectButton" Text="Connect an account"
                        Clicked="OnConnectClicked" Style="{StaticResource SecondaryButton}" Margin="0,4,0,0" />
                <Label x:Name="ConnectStatusLabel" Style="{StaticResource StatusLine}" />
            </VerticalStackLayout>

            <BoxView x:Name="ConnectedAccountsDivider" HeightRequest="1" Color="{StaticResource Hairline}" Margin="0,12" />

            <!-- ==================== Google account ==================== -->
            <Label Text="Google account" Style="{StaticResource TitleLabel}" />
            <Label x:Name="GoogleIntroLabel" Style="{StaticResource SecondaryLabel}" />
            <!-- Her install (mockup 11): once signed in, the account stands here in place of the button. -->
            <VerticalStackLayout x:Name="SignedInBlock" Spacing="2" IsVisible="False">
                <Label x:Name="SignedInHeadingLabel" Style="{StaticResource FieldLabel}" />
                <Label x:Name="SignedInLineLabel" Style="{StaticResource SecondaryLabel}" />
            </VerticalStackLayout>
            <Button x:Name="VoiceSignInButton" Text="Sign in with Google"
                    Clicked="OnVoiceSignInClicked" Style="{StaticResource SecondaryButton}" />
            <Label x:Name="VoiceStatusLabel" Style="{StaticResource StatusLine}" />

            <BoxView x:Name="GoogleAccountDivider" HeightRequest="1" Color="{StaticResource Hairline}" Margin="0,12" />

            <!-- ==================== Budget ====================
                 Not on mockup 11's own list of what survives on her install (D36's own words: "no
                 budget categories, tracking switch or diagnostics"). -->
            <VerticalStackLayout x:Name="BudgetSection" Spacing="4">
                <Label Text="Budget" Style="{StaticResource TitleLabel}" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Tracking only" Style="{StaticResource FieldLabel}" />
                        <Label Text="Watch spending without limits this month" Style="{StaticResource SecondaryLabel}" />
                    </VerticalStackLayout>
                    <Switch x:Name="TrackingOnlySwitch" Grid.Column="1" VerticalOptions="Center"
                            Toggled="OnTrackingOnlyToggled" />
                </Grid>

                <Label Text="Categories" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                <!-- Long-press-to-manage (D55/D110) is drawn as a tap here instead: .NET MAUI has no
                     stock long-press recognizer, and a hand-timed PointerGestureRecognizer's press/release
                     pair is unverified on Android touch input with no device available to try it on.
                     Tapping a row opens the same Rename/Move/Remove choices an action sheet, undo-first. -->
                <VerticalStackLayout x:Name="CategoriesList" Spacing="2"
                                     BindableLayout.ItemsSource="{Binding .}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCategoryTapped" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="{Binding .}" Style="{StaticResource SecondaryLabel}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="⋮" Style="{StaticResource SecondaryLabel}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label x:Name="AddCategoryLabel" Text="Add a category" Style="{StaticResource SecondaryLabel}"
                       Margin="0,6,0,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAddCategoryClicked" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>

            <BoxView x:Name="BudgetDivider" HeightRequest="1" Color="{StaticResource Hairline}" Margin="0,12" />

            <!-- ==================== Diagnostics (D145) ====================
                 Also not on mockup 11's list — hidden alongside Budget on her install. -->
            <VerticalStackLayout x:Name="DiagnosticsSection" Spacing="4">
                <Label Text="Diagnostics" Style="{StaticResource TitleLabel}" />
                <Label Text="What Index noticed going wrong, from every part of the app, as one file to send. No keys, tokens or account numbers."
                       Style="{StaticResource SecondaryLabel}" />
                <Button Text="Export diagnostics" Clicked="OnExportDiagnosticsClicked" Style="{StaticResource SecondaryButton}" />
                <Label x:Name="DiagnosticsStatusLabel" Style="{StaticResource StatusLine}" />
            </VerticalStackLayout>

            <!-- ==================== The foot (D41, D146) ====================
                 The maker's mark, moved down here from the top of the page, beside the version and
                 package line — the layout mockup 10 draws, over the same BuildLine.Format() text the
                 whole suite already shares (only the app name passed to it was stale "Ledger" from
                 before the rename; fixed alongside the move). -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,20,0,0">
                <Image Grid.Column="0" Source="owner_medallion.png" WidthRequest="40" HeightRequest="40"
                       VerticalOptions="Center" />
                <Label x:Name="BuildLineLabel" Grid.Column="1"
                       Style="{StaticResource MonoLabel}"
                       VerticalOptions="Center"
                       LineBreakMode="WordWrap" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</pages:LedgerBinderPage>
