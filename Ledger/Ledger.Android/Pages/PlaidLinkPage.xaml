<?xml version="1.0" encoding="utf-8" ?>
<pages:LedgerBinderPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Ledger.Android.Pages"
             x:Class="Ledger.Android.Pages.PlaidLinkPage">
    <!-- The header and the binder strip come from LedgerBinderPage; this is the well between them.
         The pinned bar (Done / Cancel) is built in code-behind via SetBar. Not a WebView: Plaid
         opens in the system browser (see this class's own remarks for why), so nothing here is an
         embedded OAuth flow the frame would sit awkwardly around. -->
    <VerticalStackLayout Padding="0,8,0,0" Spacing="16" VerticalOptions="Start">
        <Label x:Name="StatusLabel" Style="{StaticResource StatusLine}"
               Text="Preparing a secure connection…" />
        <Label x:Name="InstructionsLabel" Style="{StaticResource StatusLine}"
               Text="Plaid opens in your browser so banks like Redwood Bank that block in-app windows can sign you in. When you finish and return here, tap Done." />
        <Button x:Name="OpenButton" Text="Open connection page" Clicked="OnOpenClicked" IsEnabled="False" />
    </VerticalStackLayout>
</pages:LedgerBinderPage>
