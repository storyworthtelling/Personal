<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ledger.Android.Pages.PlaidLinkPage"
             Title="Connect an account">
    <Grid RowDefinitions="Auto,*,Auto" Padding="0">

        <VerticalStackLayout Grid.Row="0" Padding="24,24,24,8" Spacing="4">
            <Label Text="Connect an account" Style="{StaticResource DisplayLabel}" />
            <Label x:Name="StatusLabel" Style="{StaticResource StatusLine}"
                   Text="Preparing a secure connection…" />
        </VerticalStackLayout>

        <WebView x:Name="LinkWebView" Grid.Row="1" />

        <!-- Pinned bottom bar (DESIGN.md §7). -->
        <VerticalStackLayout Grid.Row="2">
            <BoxView HeightRequest="1" Color="{StaticResource Hairline}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Padding="24,12">
                <Button Grid.Column="0" x:Name="DoneButton" Text="Done" Clicked="OnDoneClicked" IsEnabled="False" />
                <Button Grid.Column="1" Text="Cancel" Clicked="OnCancelClicked" Style="{StaticResource QuietButton}" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
