<?xml version="1.0" encoding="utf-8" ?>
<pages:LedgerBinderPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Ledger.Android.Pages"
             x:Class="Ledger.Android.Pages.MainPage">
    <!-- The header and the binder strip come from LedgerBinderPage; this is the well between them.
         The pinned bar (Refresh now) is built in code-behind via SetBar — Settings used to sit
         beside it as a second button, which is the binder's job now. -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="{StaticResource ScreenPadding}" RowSpacing="12">

        <!-- A greeting in the owner's voice when a shared profile exists; otherwise hidden (neutral). -->
        <Label Grid.Row="0" x:Name="WelcomeLabel"
               Style="{StaticResource SecondaryLabel}"
               IsVisible="False" />

        <Border x:Name="ConfigWarningCard" Grid.Row="1"
                Style="{StaticResource WarningCard}" IsVisible="False">
            <Label Text="Add your Plaid client ID and secret in Settings, then connect an account."
                   FontSize="{StaticResource SecondarySize}" />
        </Border>

        <Label Grid.Row="2" x:Name="NetLabel" Style="{StaticResource SecondaryLabel}" IsVisible="False" />

        <CollectionView x:Name="InstitutionsList" Grid.Row="3">
            <CollectionView.EmptyView>
                <Label Text="No accounts yet. Connect your bank, cards, and loans from Settings."
                       Style="{StaticResource EmptyStateLabel}" Margin="0,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource HairlineCard}" Margin="0,4">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{Binding Name}" Style="{StaticResource HeadingLabel}" />
                                <Border Grid.Column="1" Style="{StaticResource ErrorChip}"
                                        VerticalOptions="Center" IsVisible="{Binding HasError}">
                                    <Label Text="needs attention" Style="{StaticResource ChipLabelError}" />
                                </Border>
                            </Grid>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Accounts}" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="4">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnAccountTapped" />
                                                </Grid.GestureRecognizers>
                                                <Label Grid.Column="0" Text="{Binding ExpandGlyph}"
                                                       Style="{StaticResource SecondaryLabel}" VerticalOptions="Center" />
                                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                    <Label Text="{Binding Title}" />
                                                    <Label Text="{Binding Detail}" Style="{StaticResource SecondaryLabel}"
                                                           IsVisible="{Binding HasDetail}" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="2" Text="{Binding AmountText}"
                                                       Style="{StaticResource AmountLabel}" VerticalOptions="Center" />
                                            </Grid>

                                            <!-- Expandable recent-transactions panel (loaded on first tap). -->
                                            <VerticalStackLayout IsVisible="{Binding IsExpanded}" Padding="22,2,0,6" Spacing="4">
                                                <Label Text="{Binding TransactionsStatus}" Style="{StaticResource StatusLine}"
                                                       IsVisible="{Binding HasTransactionsStatus}" />
                                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Transactions}" Spacing="4">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                                <VerticalStackLayout Grid.Column="0" Spacing="1">
                                                                    <Label Text="{Binding Title}" FontSize="{StaticResource SecondarySize}" />
                                                                    <Label Text="{Binding DateText}" Style="{StaticResource SecondaryLabel}" />
                                                                </VerticalStackLayout>
                                                                <Label Grid.Column="1" Text="{Binding AmountText}"
                                                                       Style="{StaticResource AmountLabel}"
                                                                       FontSize="{StaticResource SecondarySize}" VerticalOptions="Center" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Label Text="{Binding Status}" Style="{StaticResource StatusLine}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="4" x:Name="LastRunLabel" Style="{StaticResource SecondaryLabel}"
               HorizontalTextAlignment="Center" />
    </Grid>
</pages:LedgerBinderPage>
