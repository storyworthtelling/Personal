<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <RootNamespace>Ledger.Android</RootNamespace>
    <ApplicationId>com.storyworthtelling.ledger</ApplicationId>
    <ApplicationTitle>Ledger</ApplicationTitle>
    <!-- versionCode comes from the shared .github/actions/version-code action (band 1), like
         every other app in the suite: band * 100,000,000 + minutes since 2020-01-01 UTC. This
         value is only the fallback for a local build; CI always overrides it with -p. It used to
         be a yearDigit + MMddHHmm timestamp computed here, which CI overrode with a bare
         run_number — so the two disagreed by seven orders of magnitude, and a locally built
         release APK could never be updated by a CI one. Storyworthtelling.Updates.SuiteVersionBands
         records the band and guards that it clears what this package has already shipped. -->
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>$([System.DateTime]::UtcNow.ToString('yyyy.MM.dd.HHmm'))</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>34</SupportedOSPlatformVersion>
    <AndroidMinSdkVersion>26</AndroidMinSdkVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- App icon = native Android adaptive-icon resources under Resources/ (mipmap-anydpi-v26/appicon.xml
       + per-density appicon/appicon_foreground PNGs), generated by Tools/IconStudio. They live in the
       plain Resources/ folder (NOT Platforms/Android/Resources) on purpose: this head does not set
       <SingleProject>true</SingleProject>, so MAUI leaves the .NET-for-Android default resource prefix
       (`Resources`) in place and never repoints it at Platforms/Android/Resources — anything under there
       is silently dropped. android:icon is set via [Application(Icon=...)] in MainApplication.cs, not the
       (unwired) XML manifest. The CI ICON CHECK fails the build if the launcher icon is missing. -->

  <ItemGroup>
    <ProjectReference Include="..\Ledger.Domain\Ledger.Domain.csproj" />
    <ProjectReference Include="..\Ledger.Infrastructure\Ledger.Infrastructure.csproj" />
    <!-- Shared owner's-voice library: Ledger reads the shared profile + key from Drive to greet the
         owner in their voice (degrading to neutral copy when unavailable). -->
    <ProjectReference Include="..\..\Storyworthtelling.Voice\Storyworthtelling.Voice.csproj" />
    <ProjectReference Include="..\..\Storyworthtelling.Updates\Storyworthtelling.Updates.csproj" />
    <!-- Only for BinderTabs (the binder tab strip component) — Ledger's Balances/Settings pages
         wire into it directly rather than adopting the kit's Paper.xaml/PaperKit dictionary.
         BinderTabs reads its own internal tokens ("Hairline"/"Ink"/"Paper"/"FieldLabel") through
         PaperResources, which walks the Application's merged resources — Ledger's own
         Resources/Styles/DesignTokens.xaml already registers all four under those exact names,
         so this is the minimal wiring rather than a full kit migration. -->
    <ProjectReference Include="..\..\Storyworthtelling.Maui\Storyworthtelling.Maui.csproj" />
  </ItemGroup>

  <!-- Google Drive read access for the shared voice profile/config (device-account sign-in). -->
  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.74.0.*" />
  </ItemGroup>

  <!-- The shared Paper & Ink fonts (aliases still registered in MauiProgram, unchanged — this head
       does not adopt PaperFonts.Register). Packaged via the Storyworthtelling.Maui project
       reference above instead of Ledger's own glob of the same files, following Foreword's and
       Folio's precedent of dropping their own MauiFont glob once that reference exists, rather than
       shipping two MauiFont items pointing at the same physical files. The CI FONT CHECK proves
       they are still packaged in the APK. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.9" />
    <PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="2.10.2" />
    <!-- Pin to resolve a Work.Runtime 2.10.2 transitive conflict under .NET 10 MAUI: AndroidX.Core
         wants Concurrent.Futures >=1.3.0.1 while Concurrent.Futures.Ktx caps it <1.2.1 (NuGet NU1107
         prescribes referencing this directly). -->
    <PackageReference Include="Xamarin.AndroidX.Concurrent.Futures" Version="1.3.0.1" />
  </ItemGroup>
</Project>
