<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared paper-composition library (net10.0, pure .NET like Storyworthtelling.Voice/Remarkable):
       the domain-free Skia+PdfSharp mechanics every app's page/report renderers stand on, plus the
       device-adaptive colour model (Paper Pro colour / rM2 grayscale / screen RGB). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Storyworthtelling.Paper</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.1.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <!-- The reMarkable transport is already its own shared library; the unified IPaperDelivery seam
       composes it (root upload) with the Drive archive so every app delivers the same way. -->
  <ItemGroup>
    <ProjectReference Include="..\Storyworthtelling.Remarkable\Storyworthtelling.Remarkable.csproj" />
  </ItemGroup>

  <!-- The shared Paper & Ink fonts, embedded for the Skia renderers (identical on the desktop test
       TFM and on device, exactly as Folio.Infrastructure embedded them before extraction). -->
  <ItemGroup>
    <EmbeddedResource Include="..\Fonts\*.ttf" Link="Fonts\%(Filename)%(Extension)" />

    <!-- The owner's medallion (DESIGN.md §13), for the same reason the fonts are here: this is the
         library that prints, and a renderer that cannot load a branding asset draws a blank rather
         than failing. Generated by Tools/IconStudio from /Branding/owner.png. -->
    <EmbeddedResource Include="..\Branding\owner.png" Link="Branding\owner.png"
                      Condition="Exists('..\Branding\owner.png')" />
  </ItemGroup>

</Project>
