<Project Sdk="Microsoft.NET.Sdk">
  <!-- Constitution's I/O. Empty until the later releases fill it; every external service is faked
       in tests. Storyworthtelling.Household (PC4), the household file store, is referenced below. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Constitution.Infrastructure</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- The calendar writes use Google's Calendar client directly; it used to arrive only through the
       Storyworthtelling.Google project, which nothing here used (audit 01 §9). -->
  <ItemGroup>
    <PackageReference Include="Google.Apis.Calendar.v3" Version="1.74.0.4154" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Constitution.Domain\Constitution.Domain.csproj" />
    <ProjectReference Include="..\..\Storyworthtelling.Voice\Storyworthtelling.Voice.csproj" />
    <ProjectReference Include="..\..\Storyworthtelling.Paper\Storyworthtelling.Paper.csproj" />
    <ProjectReference Include="..\..\Storyworthtelling.Remarkable\Storyworthtelling.Remarkable.csproj" />
    <ProjectReference Include="..\..\Storyworthtelling.Handwriting\Storyworthtelling.Handwriting.csproj" />
    <ProjectReference Include="..\..\Storyworthtelling.Household\Storyworthtelling.Household.csproj" />
  </ItemGroup>
</Project>
