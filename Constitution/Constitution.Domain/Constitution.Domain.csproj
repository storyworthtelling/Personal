<Project Sdk="Microsoft.NET.Sdk">
  <!-- Constitution's rules, pure .NET: every layer can see it, including the desktop test build,
       which is what lets the guards run with no Android workload installed. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Constitution.Domain</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- TempoBands and DesignTokens (plan 2.1). -->
    <ProjectReference Include="..\..\FocusPhone\Codex.Domain\Codex.Domain.csproj" />
    <!-- The household file engine (PC4): clock, records with tombstones, merge. Constitution's kinds and
         typed record maps sit on it; the library itself knows no kind. -->
    <ProjectReference Include="..\..\Storyworthtelling.Household\Storyworthtelling.Household.csproj" />
  </ItemGroup>
</Project>
