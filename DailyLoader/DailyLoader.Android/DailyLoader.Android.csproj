<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <RootNamespace>DailyLoader.Android</RootNamespace>
    <ApplicationId>com.storyworthtelling.dailyloader</ApplicationId>
    <ApplicationTitle>Daily Loader</ApplicationTitle>
    <!-- versionCode comes from the shared .github/actions/version-code action (band 7), like
         every other app in the suite: band * 100,000,000 + minutes since 2020-01-01 UTC. This
         value is only the fallback for a local build; CI always overrides it with -p. It used
         to be a yearDigit + MMddHHmm timestamp computed here, which was correct but was the one
         app doing its own thing — and a second implementation of the same rule is how the two
         run_number floors drifted. Storyworthtelling.Updates.SuiteVersionBands records the band
         and guards that it clears what this package has already shipped. -->
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>$([System.DateTime]::UtcNow.ToString('yyyy.MM.dd.HHmm'))</ApplicationDisplayVersion>
    <AndroidMinSdkVersion>26</AndroidMinSdkVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- App icon = native Android adaptive-icon resources under Resources/ (mipmap-*), generated by
       Tools/IconStudio. MAUI's MauiIcon/resizetizer pipeline is bypassed. The resources live in the
       plain Resources/ folder (NOT Platforms/Android/Resources) on purpose: this head does not set
       <SingleProject>true</SingleProject>, so MAUI leaves the .NET-for-Android default resource prefix
       (`Resources`) in place — anything under Platforms/Android/Resources is never packaged. android:icon
       is set via [Application(Icon=...)] in MainApplication.cs, not the (unwired) XML manifest. The CI
       ICON CHECK fails the build if the launcher icon is missing from the APK. -->

  <ItemGroup>
    <ProjectReference Include="..\DailyLoader.Infrastructure\DailyLoader.Infrastructure.csproj" />
    <!-- Shared owner's-voice library: greet the owner in their voice on the delivery screen, reading the
         shared profile + Claude key from Drive (brings Google.Apis.Drive.v3/Auth transitively). -->
    <ProjectReference Include="..\..\Storyworthtelling.Voice\Storyworthtelling.Voice.csproj" />
    <ProjectReference Include="..\..\Storyworthtelling.Remarkable\Storyworthtelling.Remarkable.csproj" />
  </ItemGroup>

  <!-- The shared Paper & Ink fonts (aliases registered in MauiProgram). -->
  <ItemGroup>
    <MauiFont Include="..\..\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
    <PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="2.10.2" />
    <!-- Pin to resolve a Work.Runtime 2.10.2 transitive conflict under .NET 10 MAUI: AndroidX.Core
         wants Concurrent.Futures >=1.3.0.1 while Concurrent.Futures.Ktx caps it <1.2.1 (NuGet NU1107).
         Matches the pin Storyboarder/Ledger already carry. -->
    <PackageReference Include="Xamarin.AndroidX.Concurrent.Futures" Version="1.3.0.1" />
  </ItemGroup>

  <!-- Preserve PDFsharp from the Release IL trimmer — uses reflection internally -->
  <ItemGroup>
    <TrimmerRootAssembly Include="PdfSharp" RootMode="All" />
  </ItemGroup>
</Project>
