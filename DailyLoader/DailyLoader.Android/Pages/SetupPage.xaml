<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DailyLoader.Android.Pages.SetupPage"
             Title="Settings">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="NYT-S cookie" Style="{StaticResource FieldLabel}" />
            <Entry x:Name="NytCookieEntry"
                   Placeholder="Paste NYT-S cookie value here"
                   Style="{StaticResource MonoEntry}" />
            <Label Text="Log into nytimes.com in Chrome, open DevTools → Application → Cookies → copy the NYT-S value."
                   Style="{StaticResource SecondaryLabel}" />

            <Label Text="NYT API key" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
            <Entry x:Name="NytApiKeyEntry"
                   Placeholder="Paste NYT API key here"
                   Style="{StaticResource MonoEntry}" />
            <Label Text="From developer.nytimes.com — used to fetch the top stories list."
                   Style="{StaticResource SecondaryLabel}" />

            <Label Text="reMarkable device token" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
            <Entry x:Name="RemarkableTokenEntry"
                   Placeholder="Paste device token, or use Register below"
                   Style="{StaticResource MonoEntry}" />
            <Label Text="Visit my.remarkable.com/device/mobile/connect for a one-time code, then tap Register below."
                   Style="{StaticResource SecondaryLabel}" />
            <Button Text="Register reMarkable device"
                    Clicked="OnRegisterRemarkableClicked"
                    Style="{StaticResource SecondaryButton}" />

            <BoxView HeightRequest="1" Color="{StaticResource Hairline}" Margin="0,12" />

            <Label Text="Google" Style="{StaticResource FieldLabel}" />
            <Label Text="Sign in with the Google account already on this phone to sync your calendars and tasks. Grant the calendar and tasks permissions when prompted."
                   Style="{StaticResource SecondaryLabel}" />
            <Button Text="Sign in with Google"
                    Clicked="OnGoogleSignInClicked"
                    Style="{StaticResource SecondaryButton}" />
            <Label x:Name="GoogleStatusLabel" Style="{StaticResource SecondaryLabel}" />

            <Label Text="Anthropic API key" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
            <Entry x:Name="AnthropicKeyEntry"
                   Placeholder="sk-ant-..."
                   Style="{StaticResource MonoEntry}" />
            <Label Text="Optional — transcribes hand-written notes back into your calendar/tasks. Read-back is skipped if blank."
                   Style="{StaticResource SecondaryLabel}" />

            <Label Text="Calendar mapping (JSON)" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
            <Editor x:Name="CalendarMappingEditor"
                    AutoSize="TextChanges"
                    HeightRequest="120"
                    FontFamily="Mono"
                    FontSize="{StaticResource MonoSize}"
                    BackgroundColor="{StaticResource PaperDeep}"
                    TextColor="{StaticResource Ink}"
                    PlaceholderColor="{StaticResource InkMuted}" />
            <Label Text="Optional — maps calendar ids to columns (Matt/Ashley/Gwen/Eva/Watch) and sets the Family calendar id. Leave blank to default everything to Matt with Gwen/Eva keyword routing."
                   Style="{StaticResource SecondaryLabel}" />

            <Button Text="Save settings"
                    Clicked="OnSaveClicked"
                    Margin="0,16,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
