<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DailyLoader.Android.Pages.SetupPage"
             Title="Settings">
    <Grid RowDefinitions="*,Auto">
    <ScrollView Grid.Row="0">
        <VerticalStackLayout Padding="{StaticResource ScreenPadding}" Spacing="16">

            <HorizontalStackLayout Spacing="12">
                <Image Source="owner_medallion.png" WidthRequest="48" HeightRequest="48"
                       VerticalOptions="Center" />
                <Label Text="Settings" Style="{StaticResource DisplayLabel}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="A working key stays put — it's backed up to the vault and restored automatically, so its field only appears when a key is missing or a call with it was just rejected."
                   Style="{StaticResource SecondaryLabel}" Margin="0,8,0,0" />

            <Label Text="NYT-S cookie" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
            <Grid x:Name="NytCookieStatusRow" ColumnDefinitions="*,Auto" IsVisible="False">
                <Label x:Name="NytCookieStatusLabel" Grid.Column="0" VerticalOptions="Center"
                       Style="{StaticResource SecondaryLabel}" />
                <Button x:Name="NytCookieReplaceButton" Grid.Column="1" Text="Replace"
                        Style="{StaticResource QuietButton}" Clicked="OnReplaceNytCookieClicked" />
            </Grid>
            <VerticalStackLayout x:Name="NytCookieFields" Spacing="8" IsVisible="False">
                <Entry x:Name="NytCookieEntry"
                       Placeholder="Paste NYT-S cookie value here"
                       Style="{StaticResource MonoEntry}" />
                <Label Text="Log into nytimes.com in Chrome, open DevTools → Application → Cookies → copy the NYT-S value."
                       Style="{StaticResource SecondaryLabel}" />
            </VerticalStackLayout>

            <Label Text="NYT API key" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
            <Grid x:Name="NytApiKeyStatusRow" ColumnDefinitions="*,Auto" IsVisible="False">
                <Label x:Name="NytApiKeyStatusLabel" Grid.Column="0" VerticalOptions="Center"
                       Style="{StaticResource SecondaryLabel}" />
                <Button x:Name="NytApiKeyReplaceButton" Grid.Column="1" Text="Replace"
                        Style="{StaticResource QuietButton}" Clicked="OnReplaceNytApiKeyClicked" />
            </Grid>
            <VerticalStackLayout x:Name="NytApiKeyFields" Spacing="8" IsVisible="False">
                <Entry x:Name="NytApiKeyEntry"
                       Placeholder="Paste NYT API key here"
                       Style="{StaticResource MonoEntry}" />
                <Label Text="From developer.nytimes.com — used to fetch the top stories list."
                       Style="{StaticResource SecondaryLabel}" />
            </VerticalStackLayout>

            <Label Text="reMarkable device token" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
            <Grid x:Name="RemarkableStatusRow" ColumnDefinitions="*,Auto" IsVisible="False">
                <Label x:Name="RemarkableStatusLabel" Grid.Column="0" VerticalOptions="Center"
                       Style="{StaticResource SecondaryLabel}" />
                <Button x:Name="RemarkableReplaceButton" Grid.Column="1" Text="Replace"
                        Style="{StaticResource QuietButton}" Clicked="OnReplaceRemarkableClicked" />
            </Grid>
            <VerticalStackLayout x:Name="RemarkableFields" Spacing="8" IsVisible="False">
                <Entry x:Name="RemarkableTokenEntry"
                       Placeholder="Paste device token, or use Register below"
                       Style="{StaticResource MonoEntry}" />
                <Label Text="Visit my.remarkable.com/device/mobile/connect for a one-time code, then tap Register below."
                       Style="{StaticResource SecondaryLabel}" />
                <Button Text="Register reMarkable device"
                        Clicked="OnRegisterRemarkableClicked"
                        Style="{StaticResource SecondaryButton}" />
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="{StaticResource Hairline}" Margin="0,12" />

            <Label Text="Google" Style="{StaticResource FieldLabel}" />
            <Label Text="Sign in with the Google account already on this phone to sync your calendars and tasks. Grant the calendar and tasks permissions when prompted."
                   Style="{StaticResource SecondaryLabel}" />
            <Button Text="Sign in with Google"
                    Clicked="OnGoogleSignInClicked"
                    Style="{StaticResource SecondaryButton}" />
            <Label x:Name="GoogleStatusLabel" Style="{StaticResource SecondaryLabel}" />

            <BoxView HeightRequest="1" Color="{StaticResource Hairline}" Margin="0,12" />

            <Label Text="Secrets vault" Style="{StaticResource FieldLabel}" />
            <Label Text="A passphrase encrypts one shared file in your Google Drive that holds every app's keys — here, your NYT cookie and key, the reMarkable token, and the Anthropic key. Set the same passphrase in each app; after a factory reset or reinstall, sign in with Google above and your keys restore automatically. Needs the Google sign-in above."
                   Style="{StaticResource SecondaryLabel}" />
            <Entry x:Name="VaultPassphraseEntry" Placeholder="Choose a passphrase"
                   Style="{StaticResource MonoEntry}" Margin="0,8,0,0" />
            <Label Text="Shown in the clear so you can read it back and copy it into your other apps — it's the one thing not stored in the vault."
                   Style="{StaticResource SecondaryLabel}" />

            <Label Text="Anthropic API key" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
            <Grid x:Name="AnthropicStatusRow" ColumnDefinitions="*,Auto" IsVisible="False">
                <Label x:Name="AnthropicStatusLabel" Grid.Column="0" VerticalOptions="Center"
                       Style="{StaticResource SecondaryLabel}" />
                <Button x:Name="AnthropicReplaceButton" Grid.Column="1" Text="Replace"
                        Style="{StaticResource QuietButton}" Clicked="OnReplaceAnthropicClicked" />
            </Grid>
            <VerticalStackLayout x:Name="AnthropicFields" Spacing="8" IsVisible="False">
                <Entry x:Name="AnthropicKeyEntry"
                       Placeholder="sk-ant-..."
                       Style="{StaticResource MonoEntry}" />
                <Label Text="Optional — transcribes hand-written notes back into your calendar/tasks. Read-back is skipped if blank."
                       Style="{StaticResource SecondaryLabel}" />
            </VerticalStackLayout>

            <Label Text="Calendar mapping (JSON)" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
            <Editor x:Name="CalendarMappingEditor"
                    AutoSize="TextChanges"
                    HeightRequest="120"
                    FontFamily="Mono"
                    FontSize="{StaticResource MonoSize}"
                    BackgroundColor="{StaticResource PaperDeep}"
                    TextColor="{StaticResource Ink}"
                    PlaceholderColor="{StaticResource InkMuted}" />
            <Label Text="Optional — maps calendar ids to columns (Rowan/Jordan/Wren/Linden/Watch) and sets the Family calendar id. Leave blank to default everything to Rowan with Wren/Linden keyword routing."
                   Style="{StaticResource SecondaryLabel}" />


            <!-- The quiet foot line: which build is actually on the phone. The update channel
                 installs silently and most updates change nothing visible, so without it
                 "did that land?" has no answer on the device. Matches Flyleaf's, via the one
                 shared Storyworthtelling.Updates.BuildLine formatter. -->
            <Label x:Name="BuildLineLabel"
                   Style="{StaticResource MonoLabel}"
                   HorizontalOptions="Center"
                   Margin="0,32,0,0" />
        </VerticalStackLayout>
    </ScrollView>

    <!-- Pinned bottom bar (DESIGN.md §7). -->
    <VerticalStackLayout Grid.Row="1">
        <BoxView HeightRequest="1" Color="{StaticResource Hairline}" />
        <Grid Padding="24,12">
            <Button Text="Save settings" Clicked="OnSaveClicked" />
        </Grid>
    </VerticalStackLayout>
    </Grid>
</ContentPage>
