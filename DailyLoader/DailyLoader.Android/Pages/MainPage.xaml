<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DailyLoader.Android.Pages.MainPage"
             Title="NYT Crossword Delivery">
    <VerticalStackLayout Padding="24" Spacing="20" VerticalOptions="Center">

        <Label Text="NYT Crossword Delivery"
               Style="{StaticResource TitleLabel}"
               HorizontalOptions="Center" />

        <Label x:Name="StatusLabel"
               Style="{StaticResource SecondaryLabel}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center" />

        <Border x:Name="ConfigWarningLabel"
                Style="{StaticResource WarningCard}" IsVisible="False">
            <Label Text="Add your credentials in Settings to start delivering."
                   FontSize="{StaticResource SecondarySize}"
                   HorizontalTextAlignment="Center" />
        </Border>

        <Border x:Name="BatteryWarningLabel"
                Style="{StaticResource WarningCard}" IsVisible="False">
            <Label Text="Battery optimization is on — automatic delivery may be blocked."
                   FontSize="{StaticResource SecondarySize}"
                   HorizontalTextAlignment="Center" />
        </Border>

        <Button x:Name="BatterySettingsButton"
                Text="Fix battery optimization"
                Clicked="OnBatterySettingsClicked"
                Style="{StaticResource SecondaryButton}"
                IsVisible="False"
                HorizontalOptions="Fill" />

        <Button x:Name="DeliverNowButton"
                Text="Deliver now"
                Clicked="OnDeliverNowClicked"
                HorizontalOptions="Fill" />

        <ActivityIndicator x:Name="Spinner"
                           IsRunning="False"
                           IsVisible="False"
                           HorizontalOptions="Center" />

        <Button Text="Settings"
                Clicked="OnSettingsClicked"
                Style="{StaticResource SecondaryButton}"
                HorizontalOptions="Fill" />

        <Button x:Name="DeliveryLogButton"
                Text="View delivery log"
                Clicked="OnDeliveryLogClicked"
                Style="{StaticResource QuietButton}"
                IsVisible="False"
                HorizontalOptions="Fill" />

        <Button x:Name="CrashLogButton"
                Text="View crash log"
                Clicked="OnCrashLogClicked"
                Style="{StaticResource DestructiveButton}"
                IsVisible="False"
                HorizontalOptions="Fill" />

    </VerticalStackLayout>
</ContentPage>
