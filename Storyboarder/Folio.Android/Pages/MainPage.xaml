<?xml version="1.0" encoding="utf-8" ?>
<!--
    The Work desk. Almost everything on it is built in code rather than declared here, because the
    desk is a composition of drawn furniture and paper that varies with what is on it — see
    MainPage.xaml.cs. What stays declarative is the two things that are the same whatever the desk
    holds: the warning card, and the quiet line saying when the worker last ran.
-->
<local:FolioBinderPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Folio.Android.Pages"
             x:Class="Folio.Android.Pages.MainPage">
    <ScrollView>
        <VerticalStackLayout Padding="24,4,16,24">

            <Border x:Name="ConfigWarningCard" IsVisible="False"
                    Style="{StaticResource WarningCard}" Margin="0,0,0,12">
                <Label x:Name="ConfigWarningLabel" FontSize="{StaticResource SecondarySize}" />
            </Border>

            <VerticalStackLayout x:Name="Desk" />

            <Label x:Name="LastRunLabel" Style="{StaticResource StatusLine}"
                   HorizontalTextAlignment="Center" Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</local:FolioBinderPage>
