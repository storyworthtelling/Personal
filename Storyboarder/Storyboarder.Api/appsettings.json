{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Claude": {
    "ApiKey": "",
    "Model": "claude-sonnet-4-6",
    "MaxTokens": 8000
  },
  "Gemini": {
    "ApiKey": "",
    "Model": "gemini-2.5-flash-image"
  },
  "Google": {
    "ClientId": "",
    "ApiKey": ""
  },
  "Storage": {
    "DatabasePath": "storyboarder.db",
    "OutputRoot": "output"
  },
  "RateLimit": {
    "ClaudeRequestsPerMinute": 5,
    "ClaudeRequestsPerDay": 2000,
    "GeminiRequestsPerMinute": 5,
    "GeminiRequestsPerDay": 100,
    "MaxAttempts": 6,
    "BaseDelaySeconds": 4,
    "MaxDelaySeconds": 600,
    "IdlePollSeconds": 10
  },
  "PageLayout": {
    "Width": 1024,
    "Height": 1536,
    "Margin": 40,
    "Gutter": 24
  }
}
