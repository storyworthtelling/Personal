<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Storyboarder.Android.Pages.ReaderPage"
             Title="Read">
    <Grid RowDefinitions="Auto,Auto,*" Padding="{StaticResource ScreenPadding}" RowSpacing="10">

        <Label Grid.Row="0" x:Name="TitleLabel" Style="{StaticResource DisplayLabel}" />

        <!-- Chapter jump. Hidden when the book has no detected chapters. -->
        <Grid Grid.Row="1" x:Name="ChapterBar" ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="False">
            <Label Grid.Column="0" Text="Chapter" VerticalOptions="Center" Style="{StaticResource FieldLabel}" />
            <Picker Grid.Column="1" x:Name="ChapterPicker" Title="Jump to chapter"
                    SelectedIndexChanged="OnChapterSelected" />
        </Grid>

        <CollectionView Grid.Row="2" x:Name="PagesList">
            <CollectionView.EmptyView>
                <Label Text="No pages have been composed yet."
                       Style="{StaticResource EmptyStateLabel}" Margin="0,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Spacing="4" Margin="0,6">
                        <Border Stroke="{StaticResource Hairline}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 8" Padding="0">
                            <Image Source="{Binding ImagePath}" Aspect="AspectFit">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPageTapped" />
                                </Image.GestureRecognizers>
                            </Image>
                        </Border>
                        <Label Text="{Binding Caption}" Style="{StaticResource SecondaryLabel}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
