<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Storyboarder.Android.Pages.MainPage"
             Title="Storyboarder">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16" RowSpacing="12">

        <Label Grid.Row="0"
               Text="Your graphic novels"
               Style="{StaticResource TitleLabel}" />

        <Border x:Name="ConfigWarningCard" Grid.Row="1"
                Style="{StaticResource WarningCard}" IsVisible="False">
            <Label Text="Add your Claude and Gemini API keys in Settings to start rendering."
                   FontSize="{StaticResource SecondarySize}" />
        </Border>

        <CollectionView x:Name="ProjectsList" Grid.Row="2"
                        SelectionMode="Single"
                        SelectionChanged="OnProjectSelected">
            <CollectionView.EmptyView>
                <Label Text="No projects yet. Start with a Google Doc — tap “New project”."
                       Style="{StaticResource EmptyStateLabel}" Margin="0,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource HairlineCard}" Margin="0,4">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}" Style="{StaticResource HeadingLabel}" />
                            <Label Text="{Binding Summary}" Style="{StaticResource SecondaryLabel}" />
                            <Label Text="{Binding Error}" Style="{StaticResource ErrorLabel}"
                                   IsVisible="{Binding HasError}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="3" Spacing="8">
            <Label x:Name="LastRunLabel" Style="{StaticResource SecondaryLabel}"
                   HorizontalTextAlignment="Center" />
            <Button Text="New project" Clicked="OnNewProjectClicked" HorizontalOptions="Fill" />
            <Button Text="Settings" Clicked="OnSettingsClicked"
                    Style="{StaticResource SecondaryButton}" HorizontalOptions="Fill" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
