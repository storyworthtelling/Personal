<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Storyboarder.Android.Pages.MainPage"
             Title="Storyboarder">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Padding="{StaticResource ScreenPadding}" RowSpacing="12">

        <Label Grid.Row="0"
               Text="Your graphic novels"
               Style="{StaticResource DisplayLabel}" />

        <Border x:Name="ConfigWarningCard" Grid.Row="1"
                Style="{StaticResource WarningCard}" IsVisible="False">
            <Label Text="Add your Claude and Gemini API keys in Settings to start rendering."
                   FontSize="{StaticResource SecondarySize}" />
        </Border>

        <CollectionView x:Name="ProjectsList" Grid.Row="2"
                        SelectionMode="Single"
                        SelectionChanged="OnProjectSelected">
            <CollectionView.EmptyView>
                <Label Text="No projects yet. Start with a Google Doc — tap “New project”."
                       Style="{StaticResource EmptyStateLabel}" Margin="0,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource HairlineCard}" Margin="0,4">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Grid.Column="0"
                                    Stroke="{StaticResource Hairline}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10" Padding="0"
                                    WidthRequest="64" HeightRequest="96"
                                    VerticalOptions="Start"
                                    IsVisible="{Binding HasCover}">
                                <Image Source="{Binding CoverThumb}" Aspect="AspectFill" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="{Binding Title}" Style="{StaticResource HeadingLabel}" />
                                <FlexLayout Wrap="Wrap" Direction="Row"
                                            BindableLayout.ItemsSource="{Binding Phases}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource PhaseChip}" Margin="0,0,6,6">
                                                <Label Text="{Binding Text}" Style="{StaticResource ChipLabel}">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="TextColor" Value="{StaticResource Ink}" />
                                                            <Setter Property="FontFamily" Value="SansSemibold" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                                <Label Text="{Binding Summary}" Style="{StaticResource StatusLine}" />
                                <Border Style="{StaticResource ErrorChip}"
                                        HorizontalOptions="Start"
                                        IsVisible="{Binding HasError}">
                                    <Label Text="needs attention" Style="{StaticResource ChipLabelError}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="3" x:Name="LastRunLabel" Style="{StaticResource SecondaryLabel}"
               HorizontalTextAlignment="Center" />

        <!-- Pinned bottom bar (DESIGN.md §7). -->
        <VerticalStackLayout Grid.Row="4" Margin="-24,0,-24,-24">
            <BoxView HeightRequest="1" Color="{StaticResource Hairline}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Padding="24,12">
                <Button Grid.Column="0" Text="New project" Clicked="OnNewProjectClicked" />
                <Button Grid.Column="1" Text="Settings" Clicked="OnSettingsClicked"
                        Style="{StaticResource QuietButton}" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
