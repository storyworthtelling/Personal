<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Storyboarder.Android.Pages.PageZoomPage"
             Title="Page"
             BackgroundColor="{StaticResource PaperDeep}">
    <Grid x:Name="Viewport" IsClippedToBounds="True">
        <Image x:Name="PageImage" Aspect="AspectFit" AnchorX="0" AnchorY="0">
            <Image.GestureRecognizers>
                <PinchGestureRecognizer PinchUpdated="OnPinch" />
                <PanGestureRecognizer PanUpdated="OnPan" />
                <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnDoubleTap" />
            </Image.GestureRecognizers>
        </Image>
    </Grid>
</ContentPage>
