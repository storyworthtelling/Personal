<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Storyboarder.Android.Pages.NewProjectPage"
             Title="New project">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" Padding="16" RowSpacing="10">

        <Button Grid.Row="0" x:Name="SignInButton"
                Text="Sign in with Google" Clicked="OnSignInClicked"
                Style="{StaticResource SecondaryButton}" />

        <Label Grid.Row="1" x:Name="AccountLabel"
               Style="{StaticResource SecondaryLabel}" />

        <Label Grid.Row="2" Text="Art style"
               Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />

        <Entry Grid.Row="3" x:Name="ArtStyleEntry" />

        <Grid Grid.Row="4" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Button Grid.Column="0" x:Name="UpButton" Text="Up"
                    Clicked="OnUpClicked" IsEnabled="False"
                    Style="{StaticResource SecondaryButton}" />
            <Label Grid.Column="1" x:Name="PathLabel" VerticalOptions="Center"
                   Style="{StaticResource MonoLabel}"
                   FontSize="{StaticResource LabelSize}"
                   TextColor="{StaticResource InkMuted}"
                   LineBreakMode="TailTruncation" />
        </Grid>

        <CollectionView Grid.Row="5" x:Name="DocsList"
                        SelectionMode="Single" SelectionChanged="OnEntrySelected">
            <CollectionView.EmptyView>
                <Label Text="Sign in, then browse your Google Drive here."
                       Style="{StaticResource EmptyStateLabel}" Margin="0,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource HairlineCard}" Padding="12,10" Margin="0,3">
                        <Label Text="{Binding Display}" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <StackLayout Grid.Row="6" Orientation="Horizontal" Spacing="8">
            <ActivityIndicator x:Name="Spinner" IsRunning="False" IsVisible="False" />
            <Label x:Name="StatusLabel" Style="{StaticResource SecondaryLabel}"
                   VerticalOptions="Center" />
        </StackLayout>

        <Grid Grid.Row="7" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Grid.Column="0" x:Name="RefreshButton" Text="Refresh"
                    Clicked="OnRefreshClicked" Style="{StaticResource SecondaryButton}" />
            <Button Grid.Column="1" x:Name="CreateButton" Text="Create"
                    Clicked="OnCreateClicked" IsEnabled="False" />
        </Grid>
    </Grid>
</ContentPage>
