<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Storyboarder.Android.Pages.NewProjectPage"
             Title="New project">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" Padding="{StaticResource ScreenPadding}" RowSpacing="10">

        <Label Grid.Row="0" x:Name="HeaderLabel" Text="New project" Style="{StaticResource DisplayLabel}" />

        <Button Grid.Row="1" x:Name="SignInButton"
                Text="Sign in with Google" Clicked="OnSignInClicked"
                Style="{StaticResource SecondaryButton}" />

        <Label Grid.Row="2" x:Name="AccountLabel"
               Style="{StaticResource SecondaryLabel}" />

        <Label Grid.Row="3" Text="Art style"
               Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />

        <Entry Grid.Row="4" x:Name="ArtStyleEntry" />

        <Grid Grid.Row="5" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Button Grid.Column="0" x:Name="UpButton" Text="Up"
                    Clicked="OnUpClicked" IsEnabled="False"
                    Style="{StaticResource SecondaryButton}" />
            <Label Grid.Column="1" x:Name="PathLabel" VerticalOptions="Center"
                   Style="{StaticResource MonoLabel}"
                   FontSize="{StaticResource LabelSize}"
                   TextColor="{StaticResource InkMuted}"
                   LineBreakMode="TailTruncation" />
        </Grid>

        <CollectionView Grid.Row="6" x:Name="DocsList"
                        SelectionMode="Single" SelectionChanged="OnEntrySelected">
            <CollectionView.EmptyView>
                <Label Text="Sign in, then browse your Google Drive here."
                       Style="{StaticResource EmptyStateLabel}" Margin="0,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource HairlineCard}" Padding="12,10" Margin="0,3">
                        <Label Text="{Binding Display}" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Loading is words, not ornaments (DESIGN.md §5). -->
        <Label Grid.Row="7" x:Name="StatusLabel" Style="{StaticResource StatusLine}" />

        <!-- Pinned bottom bar (DESIGN.md §7). -->
        <VerticalStackLayout Grid.Row="8" Margin="-24,0,-24,-24">
            <BoxView HeightRequest="1" Color="{StaticResource Hairline}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Padding="24,12">
                <Button Grid.Column="0" x:Name="RefreshButton" Text="Refresh"
                        Clicked="OnRefreshClicked" Style="{StaticResource SecondaryButton}" />
                <Button Grid.Column="1" x:Name="CreateButton" Text="Create"
                        Clicked="OnCreateClicked" IsEnabled="False" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
