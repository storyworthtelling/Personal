<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Storyboarder.Android.Pages.SetupPage"
             Title="Settings">
    <Grid RowDefinitions="*,Auto">
    <ScrollView Grid.Row="0">
        <VerticalStackLayout Padding="{StaticResource ScreenPadding}" Spacing="14">

            <HorizontalStackLayout Spacing="12">
                <Image Source="owner_medallion.png" WidthRequest="48" HeightRequest="48"
                       VerticalOptions="Center" />
                <Label Text="Settings" Style="{StaticResource DisplayLabel}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Border x:Name="MigrationErrorCard" IsVisible="False" Style="{StaticResource WarningCard}" Margin="0,8,0,0">
                <Label x:Name="MigrationErrorLabel" FontSize="{StaticResource SecondarySize}" />
            </Border>

            <Label Text="API keys" Style="{StaticResource TitleLabel}" Margin="0,8,0,0" />

            <Label Text="Claude (Anthropic) API key" Style="{StaticResource FieldLabel}" />
            <Entry x:Name="ClaudeKeyEntry" Placeholder="sk-ant-..."
                   Style="{StaticResource MonoEntry}" />
            <Label Text="Builds the design bible and storyboards the book. From console.anthropic.com."
                   Style="{StaticResource SecondaryLabel}" />

            <Label Text="Gemini API key" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
            <Entry x:Name="GeminiKeyEntry" Placeholder="AIza..."
                   Style="{StaticResource MonoEntry}" />
            <Label Text="Renders the panel images. From aistudio.google.com."
                   Style="{StaticResource SecondaryLabel}" />

            <BoxView HeightRequest="1" Color="{StaticResource Hairline}" Margin="0,12" />

            <Label Text="Google account" Style="{StaticResource TitleLabel}" />
            <Label Text="Sign in with the Google account on this phone to pick a Doc to convert. Grant the documents and Drive read permissions when prompted."
                   Style="{StaticResource SecondaryLabel}" />
            <Button Text="Sign in with Google"
                    Clicked="OnGoogleSignInClicked" Style="{StaticResource SecondaryButton}" />
            <Label x:Name="GoogleStatusLabel" Style="{StaticResource SecondaryLabel}" />

            <Border Style="{StaticResource WarningCard}" Margin="0,8,0,0">
                <Label Text="One-time setup in Google Cloud Console: create an Android OAuth client with the package and SHA-1 below, enable the Google Docs &amp; Drive APIs, and add your account as a test user."
                       FontSize="{StaticResource SecondarySize}" />
            </Border>
            <Label x:Name="SigningInfoLabel" Style="{StaticResource MonoLabel}"
                   FontSize="{StaticResource LabelSize}" />
            <Button Text="Copy package + SHA-1"
                    Clicked="OnCopySigningInfoClicked" Style="{StaticResource SecondaryButton}" />
            <Label x:Name="CopyStatusLabel" Style="{StaticResource StatusLine}" />

            <BoxView HeightRequest="1" Color="{StaticResource Hairline}" Margin="0,12" />

            <Label Text="Archive to Drive" Style="{StaticResource TitleLabel}" />
            <Label Text="When a book finishes, copy its volume PDFs and revision report into a folder beside the manuscript in your Google Drive. Needs the Drive permission — sign in again after turning this on, and if Google doesn't ask for it, the app's OAuth client still needs the drive.file scope added."
                   Style="{StaticResource SecondaryLabel}" />
            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                <Label Grid.Column="0" Text="Archive finished books" VerticalOptions="Center" />
                <Switch Grid.Column="1" x:Name="ArchiveSwitch" Toggled="OnArchiveToggled" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="Free up space after archiving" VerticalOptions="Center" />
                <Switch Grid.Column="1" x:Name="FreeSpaceSwitch" Toggled="OnFreeSpaceToggled" />
            </Grid>
            <Label Text="Freeing space deletes the panel and page images once the upload is confirmed. The PDFs are always kept."
                   Style="{StaticResource SecondaryLabel}" />

            <BoxView HeightRequest="1" Color="{StaticResource Hairline}" Margin="0,12" />

            <Label Text="Progress backup" Style="{StaticResource TitleLabel}" />
            <Label Text="Save your whole library — every conversion and rendered page — to a file you choose. If you reinstall the app or move to a new phone, restore the file to pick up a long conversion where you left off."
                   Style="{StaticResource SecondaryLabel}" />
            <Button x:Name="BackupButton" Text="Back up progress"
                    Clicked="OnBackupClicked" Style="{StaticResource SecondaryButton}" />
            <Button x:Name="RestoreButton" Text="Restore from a backup"
                    Clicked="OnRestoreClicked" Style="{StaticResource SecondaryButton}" />
            <Label x:Name="BackupStatusLabel" Style="{StaticResource StatusLine}" />

            <BoxView HeightRequest="1" Color="{StaticResource Hairline}" Margin="0,12" />

            <Label Text="Diagnostics" Style="{StaticResource TitleLabel}" />
            <Label Text="See what each project is doing and what's gone wrong. Status snapshot is the quickest read; Export bundles the snapshot and both logs into one file to share."
                   Style="{StaticResource SecondaryLabel}" />
            <Button x:Name="StatusSnapshotButton" Text="Status snapshot"
                    Clicked="OnStatusSnapshotClicked" Style="{StaticResource SecondaryButton}" />
            <Button x:Name="PipelineLogButton" Text="Pipeline log"
                    Clicked="OnPipelineLogClicked" Style="{StaticResource SecondaryButton}" />
            <Button x:Name="CrashLogButton" Text="Crash log"
                    Clicked="OnCrashLogClicked" Style="{StaticResource SecondaryButton}" />
            <Button x:Name="BlockedPanelReportButton" Text="Blocked panel report"
                    Clicked="OnBlockedPanelReportClicked" Style="{StaticResource SecondaryButton}" />
            <Button x:Name="ExportDiagnosticsButton" Text="Export diagnostics"
                    Clicked="OnExportDiagnosticsClicked" Style="{StaticResource SecondaryButton}" />
            <Label x:Name="DiagnosticsStatusLabel" Style="{StaticResource StatusLine}" />

        </VerticalStackLayout>
    </ScrollView>

    <!-- Pinned bottom bar (DESIGN.md §7). -->
    <VerticalStackLayout Grid.Row="1">
        <BoxView HeightRequest="1" Color="{StaticResource Hairline}" />
        <Grid Padding="24,12">
            <Button Text="Save settings" Clicked="OnSaveClicked" />
        </Grid>
    </VerticalStackLayout>
    </Grid>
</ContentPage>
