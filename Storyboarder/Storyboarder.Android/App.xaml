<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Storyboarder.Android.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="PageBackground">#1a1a1a</Color>
            <Color x:Key="TextPrimary">#ffffff</Color>
            <Color x:Key="TextSecondary">#aaaaaa</Color>
            <Color x:Key="Accent">#5b8def</Color>
            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,10" />
            </Style>
            <Style TargetType="Entry">
                <Setter Property="BackgroundColor" Value="#2d2d2d" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextSecondary}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
