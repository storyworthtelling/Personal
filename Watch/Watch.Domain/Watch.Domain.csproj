<Project Sdk="Microsoft.NET.Sdk">
  <!-- The watch's rules, pure .NET with no package: the tokens, the day colour, the hour shape, the kit's
       geometry and the haptic plan (P14 E1). Every watch head and the desktop test build can see it, so the guards run with no
       Android workload installed. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Watch.Domain</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- BCL-only: the suite's one undo window (six seconds, or Android's time to take action if longer). -->
    <ProjectReference Include="..\..\Storyworthtelling.Folds\Storyworthtelling.Folds.csproj" />
  </ItemGroup>
</Project>
