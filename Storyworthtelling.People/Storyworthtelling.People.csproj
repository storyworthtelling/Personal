<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The household's people, owned by Foreword: one list of who lives here (adults and children, birthdates,
    Google addresses, pickup, each person's calendar) and the household's rhythm (the family calendar, dinner,
    bedtime, the zone), kept as records in one encrypted, merge-safe Drive file
    (storyworthtelling-household.json) on the Storyworthtelling.Household engine. Foreword edits it on the
    owner's phone; Constitution, Pulp and the partner's phone read it, and each app links its own ids for a
    person through a link field. Pure net10.0.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Storyworthtelling.People</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Storyworthtelling.Household\Storyworthtelling.Household.csproj" />
  </ItemGroup>

</Project>
