<Project Sdk="Microsoft.NET.Sdk">

  <!-- Reads the kit by content, because the kit itself needs the MAUI/Android workload and this
       suite has to run without it. The Storyworthtelling.Paper reference is the point: the palette
       is asserted against the GENERATED tokens by reflection, so no hand-typed copy sits on the
       expected side where it can be wrong in the same way as the code. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Storyworthtelling.Paper\Storyworthtelling.Paper.csproj" />
    <ProjectReference Include="..\Storyworthtelling.Diagnostics\Storyworthtelling.Diagnostics.csproj" />
  </ItemGroup>

  <!-- The kit's PURE files, compiled straight into this project. The kit itself is
       net10.0-android and cannot be referenced from here, but its geometry and its state rules
       carry no MAUI types — so they are tested as real code rather than as text. Anything that
       touches a MAUI type stays out of this list and is checked by content instead. -->
  <ItemGroup>
    <Compile Include="..\Storyworthtelling.Maui\DesignTokens.cs" Link="Kit\DesignTokens.cs" />
    <Compile Include="..\Storyworthtelling.Maui\Layout\*.cs" Link="Kit\Layout\%(Filename)%(Extension)" />
    <Compile Include="..\Storyworthtelling.Maui\State\*.cs" Link="Kit\State\%(Filename)%(Extension)" />
    <Compile Include="..\Storyworthtelling.Maui\Time\*.cs" Link="Kit\Time\%(Filename)%(Extension)" />
    <Compile Include="..\Storyworthtelling.Maui\Diagnostics\FileLogger.cs" Link="Kit\Diagnostics\FileLogger.cs" />
    <Compile Include="..\Storyworthtelling.Maui\Diagnostics\MauiLog.cs" Link="Kit\Diagnostics\MauiLog.cs" />
  </ItemGroup>

</Project>
