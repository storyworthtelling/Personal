<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The detectors live in the log-loop reader so CI's leakscan and these guards read one copy. -->
  <ItemGroup>
    <ProjectReference Include="..\Tools\LogLoopReader\LogLoopReader.csproj" />
    <!-- The suite's Settings order, which SettingsStandardTests reads the MAUI pages against. -->
    <ProjectReference Include="..\Storyworthtelling.Updates\Storyworthtelling.Updates.csproj" />
  </ItemGroup>

</Project>
